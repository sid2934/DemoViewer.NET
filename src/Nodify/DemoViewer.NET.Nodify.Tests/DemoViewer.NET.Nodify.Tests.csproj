<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The guard on the vendored Nodify fork (../README.md). Its whole reason to exist is that
      COMPILING NODIFY PROVES NOTHING: the published NodifyAvalonia 6.6.0 package also compiles
      against Avalonia 12 and then throws TypeLoadException at JIT. These tests load the assembly,
      merge its theme and realise nodes, so a future Avalonia bump fails here instead of in front
      of a user.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>DemoViewer.NET.NodifyTests</RootNamespace>
        <!-- CA1707: test method names conventionally use underscores (e.g. Method_Condition_Expected) -->
        <NoWarn>$(NoWarn);CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit"/>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Headless"/>
        <PackageReference Include="Avalonia.Skia"/>
        <PackageReference Include="Avalonia.Themes.Fluent"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Nodify\Nodify.csproj"/>
    </ItemGroup>

</Project>
