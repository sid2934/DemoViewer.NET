<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The stable third-party reference target for workspace modules. Deliberately
      MINIMAL: it references only Avalonia (the ViewFactory yields a Control) and has NO Parser /
      EntityTracking / Analysis reference — the read surface is pure interfaces. The concrete join
      logic (PawnLookup, PositionUtil, ModuleContext) lives in the App project, which DOES reference
      Analysis. Keeping abstractions clean is what makes it a versionable SDK target.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia"/>
    </ItemGroup>

</Project>
