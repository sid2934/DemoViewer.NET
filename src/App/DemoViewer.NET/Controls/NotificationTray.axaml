<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ext="using:DemoViewer.NET.Extensions"
             x:Class="DemoViewer.NET.Controls.NotificationTray"
             x:Name="Root">

    <!--
        The extensions' notifications, newest on top, drawn just above the status strip's right end. The
        stack sizes to its cards and takes no input where it has none, so the strip below never moves.
        The dot reuses the status chip's state classes: Info is the accent, Success good, Warning caution.
    -->
    <ItemsControl ItemsSource="{Binding Items, ElementName=Root}" Width="320">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" Spacing="6" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="ext:NotificationCardViewModel">
                <Border Classes="card-flyout" Padding="10 8" BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                        <Ellipse Grid.Column="0" Grid.Row="0" Classes="dot" Width="9" Height="9" Margin="0 0 8 0"
                                 Classes.stateWorking="{Binding IsInfo}"
                                 Classes.stateGood="{Binding IsSuccess}"
                                 Classes.stateDegraded="{Binding IsWarning}"
                                 Classes.stateError="{Binding IsError}" />
                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Title}"
                                   Foreground="{DynamicResource TextBright}" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Grid.Row="0" Classes="ghost" Padding="4 0" MinHeight="0"
                                Content="✕" FontSize="11" Foreground="{DynamicResource TextDim}"
                                ToolTip.Tip="Close" Command="{Binding DismissCommand}" />
                        <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Text="{Binding Body}"
                                   IsVisible="{Binding HasBody}" TextWrapping="Wrap" MaxLines="4"
                                   Foreground="{DynamicResource TextMid}" FontSize="12" Margin="0 4 0 0" />
                        <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding SourceName}" Classes="mono"
                                   Foreground="{DynamicResource TextDim}" FontSize="10" Margin="0 6 0 0"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" HorizontalAlignment="Right"
                                Classes="ghost" Padding="8 2" MinHeight="0" Margin="0 4 0 0"
                                IsVisible="{Binding HasAction}" Content="{Binding ActionLabel}"
                                Command="{Binding RunActionCommand}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>

</UserControl>
