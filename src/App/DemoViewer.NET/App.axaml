<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DemoViewer.NET"
             x:Class="DemoViewer.NET.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://DemoViewer.NET/Styles/DarkPalette.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- AvaloniaEdit control theme (Workbench editor). Without it the TextEditor renders
             but has no control template, so it is not interactive. -->
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <!-- Design-system foundation: the former Styles/Components.axaml split into four role
             files. Loaded AFTER FluentTheme so these additive style classes layer over the Fluent base
             (they never replace its control templates). See docs/ui/design-system.md. -->
        <StyleInclude Source="avares://DemoViewer.NET/Styles/Primitives.axaml" />
        <StyleInclude Source="avares://DemoViewer.NET/Styles/Cards.axaml" />
        <StyleInclude Source="avares://DemoViewer.NET/Styles/Tables.axaml" />
        <StyleInclude Source="avares://DemoViewer.NET/Styles/Chrome.axaml" />
    </Application.Styles>
</Application>