<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DemoViewer.NET.Extensions.Sdk.Ui.Controls"
             xmlns:reports="using:DemoViewer.NET.Services.ErrorReports"
             xmlns:vm="using:DemoViewer.NET.ViewModels.ErrorReport"
             x:Class="DemoViewer.NET.Views.ErrorReport.ErrorReportView"
             x:DataType="vm:ErrorReportViewModel"
             MinWidth="440">

    <!--
        REPORT ANALYSIS ERRORS. The whole window body. ErrorReportWindow is a thin Window that hosts this,
        the SettingsWindow/SettingsView shape, so the same body serves the desktop window and a single-view
        host.

        LAYOUT: a DockPanel whose dock ORDER is the priority order (footer, header, diagnostics, editor).
        Window metrics this is built for: 680x720, MinWidth 460, MinHeight 600. Below that the expanded
        diagnostics no longer fit and are clipped.

        Every colour is a {DynamicResource} token. TextDim is 1.99:1 on PanelBg and is used nowhere here.
    -->

    <Design.DataContext>
        <vm:ErrorReportViewModel />
    </Design.DataContext>

    <UserControl.Styles>

        <!-- Tiny uppercase label naming a block. -->
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
        </Style>

        <!-- The report's identity. The window can be open over a demo the shell does not have loaded, so
             the file name is the largest thing in it. -->
        <Style Selector="TextBlock.demoName">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextCardHeader}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.demoMeta">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- The prompt lives here, not only in the placeholder: Avalonia draws a placeholder at half
             opacity, so no token clears AA through it. -->
        <Style Selector="TextBlock.notesHint">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.demoPath">
            <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxLines" Value="2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Diagnostics rows: the KeyValueTable language, but the value WRAPS. A sha256 and a user-home
             path are the normal case here and that control's Auto value column clips them. -->
        <Style Selector="TextBlock.groupTitle">
            <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
        </Style>
        <Style Selector="TextBlock.kvKey">
            <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.kvValue">
            <Setter Property="FontFamily" Value="Consolas,Menlo,monospace" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextEntityFieldVal}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- A ToggleButton rather than an Expander, so IsDiagnosticsExpanded is a plain two-way binding
             and Copy can sit beside the toggle instead of nested inside it. -->
        <Style Selector="ToggleButton.disclosure">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8 4" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <!-- Every state is re-stated with its own pseudo-class selector: a pseudo-class setter binds at
             StyleTrigger priority and outranks the plain .disclosure setters above. -->
        <Style Selector="ToggleButton.disclosure:checked">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
        </Style>
        <Style Selector="ToggleButton.disclosure:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
        </Style>
        <Style Selector="ToggleButton.disclosure:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelHeaderHoverDeep}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
        </Style>
        <Style Selector="ToggleButton.disclosure:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelHeaderHoverDeep}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
        </Style>
        <Style Selector="ToggleButton.disclosure:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelHeaderHoverDeep}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
        </Style>
        <Style Selector="ToggleButton.disclosure:checked:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PanelHeaderHoverDeep}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
        </Style>
        <Style Selector="PathIcon.caret">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
        </Style>
        <Style Selector="ToggleButton.disclosure:checked PathIcon.caret">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>

    </UserControl.Styles>

    <DockPanel Margin="18" LastChildFill="True">

        <!-- ── Footer: docked FIRST so the actions are never the thing that gets squeezed out ──────── -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0 12 0 0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource TextBright}"
                           FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding LastSavedText}"
                           IsVisible="{Binding LastSavedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{DynamicResource TextMid}"
                           FontSize="11" VerticalAlignment="Center" />
            </Grid>

            <DockPanel LastChildFill="False">
                <!-- Disabled by design this round. ShowOnDisabled, because a disabled control suppresses
                     tooltips by default and the tooltip is the only place the reason is written. -->
                <Button DockPanel.Dock="Left" Content="Submit For Review"
                        Command="{Binding SubmitForReviewCommand}"
                        FontSize="12" Padding="12 5"
                        ToolTip.ShowOnDisabled="True"
                        ToolTip.Tip="Sends your report and all of the diagnostic information above to the developers for review. Not yet available."
                        AutomationProperties.Name="Submit For Review" />
                <Button DockPanel.Dock="Right" Classes="primary" Content="Save"
                        Command="{Binding SaveCommand}"
                        FontSize="12" Padding="18 6" Margin="8 0 0 0" />
                <Button DockPanel.Dock="Right" Classes="ghost" Content="Close"
                        Command="{Binding CloseCommand}"
                        FontSize="12" Padding="14 6" />
            </DockPanel>
        </StackPanel>

        <!-- ── Which demo this report is about ─────────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource BorderAccent}"
                BorderThickness="1" CornerRadius="6" Padding="14 12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="REPORTING ON" Classes="eyebrow" />
                    <TextBlock Text="{Binding DemoFileName}" Classes="demoName" />
                    <TextBlock Text="{Binding MapDisplay}" Classes="demoMeta" />
                    <TextBlock Text="{Binding DemoFilePath}" Classes="demoPath"
                               ToolTip.Tip="{Binding DemoFilePath}" />
                </StackPanel>

                <!-- An existing report is being EDITED, not started. Said in words rather than implied by
                     the notes box already having text in it. -->
                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Top"
                            IsVisible="{Binding IsExistingReport}">
                    <TextBlock Text="SAVED REPORT" Classes="eyebrow" TextAlignment="Right" />
                    <TextBlock Text="{Binding CreatedText}" Classes="demoPath"
                               MaxLines="1" TextAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── What travels with the notes ─────────────────────────────────────────────────────────── -->
        <!-- ClipToBounds, because a DockPanel clamps a docked child's ARRANGED height but a Border does
             not clip: below the window's MinHeight this section's content overflowed onto the footer. -->
        <Border DockPanel.Dock="Bottom" Margin="0 12 0 0" ClipToBounds="True"
                Background="{DynamicResource PanelBg}"
                BorderBrush="{DynamicResource BorderAccent}"
                BorderThickness="1" CornerRadius="6">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4 3">
                    <ToggleButton Grid.Column="0" Classes="disclosure"
                                  IsChecked="{Binding IsDiagnosticsExpanded, Mode=TwoWay}"
                                  AutomationProperties.Name="Show the diagnostic information this report includes">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Classes="caret" Data="M 2 0 L 8 5 L 2 10 Z"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="Diagnostic information sent with this report"
                                       FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <!-- Outside the toggle on purpose: copying is useful while the section is collapsed,
                         and a button nested in a ToggleButton fights it for the click. -->
                    <Button Grid.Column="1" Classes="ghost" Content="Copy diagnostics"
                            FontSize="11" Padding="10 4"
                            VerticalAlignment="Center"
                            Click="OnCopyDiagnosticsClick"
                            AutomationProperties.Name="Copy diagnostics"
                            ToolTip.Tip="Copies this report and the rows below as plain text." />
                </Grid>

                <Rectangle Classes="divider" Height="1" HorizontalAlignment="Stretch"
                           IsVisible="{Binding IsDiagnosticsExpanded}" />

                <!-- Capped: expanding takes space from the editor, never from the footer. -->
                <ScrollViewer MaxHeight="240" Padding="0 0 0 10"
                              IsVisible="{Binding IsDiagnosticsExpanded}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DiagnosticGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="reports:ErrorReportDiagnosticsGroup">
                                <StackPanel Margin="0 9 0 0" Spacing="3">
                                    <TextBlock Text="{Binding Title}" Classes="groupTitle" Margin="12 0" />
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="controls:KvpRow">
                                                <!-- A FIXED key gutter, not Auto: each row is its own
                                                     ItemsControl item, so an Auto column would size per
                                                     row and the keys would not line up down the list. -->
                                                <Grid ColumnDefinitions="156,*" ColumnSpacing="10"
                                                      Margin="12 1">
                                                    <TextBlock Grid.Column="0" Text="{Binding Key}"
                                                               Classes="kvKey" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}"
                                                               Classes="kvValue" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- ── The notes: the point of the window, and the only part that grows ────────────────────── -->
        <DockPanel Margin="0 12 0 0" ClipToBounds="True">
            <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0 0 0 6">
                <TextBlock Text="YOUR NOTES" Classes="eyebrow" VerticalAlignment="Center"
                           Margin="0 0 10 0" />
                <TextBlock Classes="notesHint" VerticalAlignment="Center"
                           Text="Name the round, the player, and what you expected to see instead." />
            </WrapPanel>
            <!-- Fluent's input chrome, like every other input in the app: its border is the only thing
                 that draws this box's edge at 3:1, and no border token in the palette does. -->
            <TextBox Text="{Binding Notes, Mode=TwoWay}"
                     PlaceholderForeground="{DynamicResource TextValue}"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     FontSize="12.5"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PlaceholderText="What did the analysis get wrong? Which round, which player, what you expected to see."
                     AutomationProperties.Name="Notes: what the analysis got wrong" />
        </DockPanel>

    </DockPanel>

</UserControl>
