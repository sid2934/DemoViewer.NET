<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sections="using:DemoViewer.NET.ViewModels.PlayerOverview.Sections"
             x:Class="DemoViewer.NET.Views.PlayerOverview.Sections.HeaderSectionView"
             x:DataType="sections:HeaderSectionViewModel"
             IsVisible="{Binding IsVisible}">

    <!--
        A compact strip above the inner tabs, so it costs every page little height. The profile address is plain
        text to copy: the app is offline and opens nothing on the web.
    -->
    <Border Classes="card" Padding="16 10">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Button Classes="ghost chip" Content="Set as me" x:Name="SetAsMeButton"
                        IsVisible="{Binding CanSetAsMe}" Command="{Binding SetAsMeCommand}"
                        ToolTip.Tip="Add this account to the accounts that are yours" />
                <Button Classes="ghost chip" Content="Set active" x:Name="SetActiveButton"
                        IsVisible="{Binding CanSetActive}" Command="{Binding SetActiveCommand}"
                        ToolTip.Tip="Use this account for your own stats" />
            </StackPanel>
            <StackPanel Spacing="3">
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold" Margin="0 0 10 0"
                               Foreground="{DynamicResource TextCardHeader}" TextTrimming="CharacterEllipsis" />
                    <Border Classes="badge" IsVisible="{Binding IsMine}" VerticalAlignment="Center" Margin="0 0 14 0">
                        <TextBlock Text="YOU" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas,Menlo,monospace" />
                    </Border>
                    <SelectableTextBlock Classes="mono" Text="{Binding SteamId64}" FontSize="12" VerticalAlignment="Center"
                                         Foreground="{DynamicResource TextMid}" />
                    <Button Classes="ghost chip" Content="Copy" Margin="6 0 16 0" Click="OnCopySteamIdClick"
                            VerticalAlignment="Center" AutomationProperties.Name="Copy SteamID64" />
                    <TextBlock Text="{Binding DemoCountText}" FontSize="12" Margin="0 0 14 0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMid}" />
                    <TextBlock Text="{Binding SeenText}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMid}" />
                </WrapPanel>
                <WrapPanel Orientation="Horizontal">
                    <SelectableTextBlock Classes="mono" Text="{Binding ProfileUrl}" FontSize="11.5" Margin="0 0 16 0"
                                         Foreground="{DynamicResource TextDim}" />
                    <TextBlock Text="{Binding Aliases}" IsVisible="{Binding HasAliases}" FontSize="11.5"
                               Foreground="{DynamicResource TextMid}" TextWrapping="Wrap" />
                </WrapPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
