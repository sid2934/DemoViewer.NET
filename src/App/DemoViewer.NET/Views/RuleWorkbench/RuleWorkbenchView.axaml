<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ae="using:AvaloniaEdit"
             xmlns:vm="using:DemoViewer.NET.Modules.RuleWorkbench"
             xmlns:rw="using:DemoViewer.NET.Views.RuleWorkbench"
             xmlns:nodify="using:Nodify"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="650"
             x:Class="DemoViewer.NET.Views.RuleWorkbench.RuleWorkbenchView"
             x:DataType="vm:RuleWorkbenchTabViewModel">

    <UserControl.Styles>
        <!-- A node the open file does not declare. Dimming is the third signal, after the lock
             glyph and the ruleset-qualified title, so the read-only marking never rests on colour
             alone. -->
        <Style Selector="nodify|Node.projected">
            <Setter Property="Opacity" Value="0.68" />
        </Style>
    </UserControl.Styles>

    <DockPanel Margin="12">

        <!-- Toolbar -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="0,0,0,8">
            <ComboBox Grid.Column="0" Width="260" MinHeight="30"
                      PlaceholderText="(open a ruleset)"
                      ItemsSource="{Binding OpenableFiles}"
                      SelectedItem="{Binding SelectedFile}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:RulesetFileRef">
                        <TextBlock Text="{Binding Display}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Content="New" Margin="8,0,0,0"
                    Command="{Binding NewFileCommand}" />
            <Button Grid.Column="2" Content="Save" Margin="6,0,0,0"
                    ToolTip.Tip="Save in place (user rulesets, or shipped in DeveloperMode)"
                    Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
            <Button Grid.Column="3" Content="Save As…" Margin="6,0,0,0" IsEnabled="{Binding CanSaveAs}"
                    ToolTip.Tip="Save the buffer as a new user ruleset (required to fork a shipped, read-only ruleset)">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="6" MinWidth="240">
                            <TextBlock Text="Save as a new user ruleset" FontWeight="SemiBold" />
                            <TextBox Text="{Binding SaveAsName}" Watermark="new-name (.rules.yaml)" />
                            <Button Content="Save" HorizontalAlignment="Right"
                                    Command="{Binding SaveAsCommand}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button Grid.Column="4" Content="Re-check" Margin="6,0,0,0"
                    Command="{Binding RunCheckCommand}" />
            <Button Grid.Column="5" Content="Evaluate" Margin="6,0,0,0"
                    ToolTip.Tip="Evaluate the open ruleset (+ its use: deps). Right-click for Advanced."
                    Command="{Binding EvaluateCommand}">
                <Button.ContextFlyout>
                    <Flyout>
                        <StackPanel Spacing="6" MinWidth="240">
                            <TextBlock Text="Advanced Evaluate — choose rulesets" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding EvaluableFiles}" MaxHeight="260">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EvaluableFile">
                                        <CheckBox Content="{Binding Display}" IsChecked="{Binding IsSelected}"
                                                  Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Evaluate selected" HorizontalAlignment="Right"
                                    Command="{Binding EvaluateAdvancedCommand}" />
                        </StackPanel>
                    </Flyout>
                </Button.ContextFlyout>
            </Button>
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="🔒 shipped (read-only — use Save As)" Foreground="{DynamicResource AccentCaution}"
                           IsVisible="{Binding IsReadOnlyFile}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Summary}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Opacity="0.75" />
            </StackPanel>
            <!-- Canvas toggle (desktop-only; hidden on WASM via GraphSupported) -->
            <ToggleButton Grid.Column="7" Content="Graph" Margin="8,0,0,0"
                          IsChecked="{Binding ShowGraph}"
                          IsVisible="{Binding GraphSupported}"
                          ToolTip.Tip="Show the open ruleset's stats and highlights as a node canvas, beside the editor rather than over it." />
        </Grid>

        <!-- Bottom: diagnostics (click a row to jump the caret) + results + trace (M6 applied fires) -->
        <Grid DockPanel.Dock="Bottom" Height="190" Margin="0,8,0,0" ColumnDefinitions="*,8,*,8,*">

            <Border Grid.Column="0" BorderBrush="{DynamicResource BorderTranslucent}" BorderThickness="1"
                    CornerRadius="4">
                <DockPanel Margin="4">
                    <TextBlock DockPanel.Dock="Top" Text="Problems — rules check diagnostics"
                               FontWeight="SemiBold" Opacity="0.7" Margin="2,2,2,4" />
                    <ListBox x:Name="DiagnosticsList"
                             ItemsSource="{Binding Diagnostics}"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkbenchDiagnostic">
                                <StackPanel Spacing="1" Margin="2,3">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Location}"
                                                   FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource AccentErrorSoft}" />
                                        <TextBlock Text="{Binding Code}" Opacity="0.5"
                                                   FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.9" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderTranslucent}" BorderThickness="1"
                    CornerRadius="4">
                <DockPanel Margin="4">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding EvalSummary}"
                               TextWrapping="Wrap" Opacity="0.75" Margin="2,2,2,4" />
                    <!-- Real scoreboard + tables: titled grids, aligned fixed-width columns. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Boards}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkbenchScoreboard">
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="2,2,2,3" />
                                        <!-- header row: label spacer + column names -->
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="120" />
                                            <ItemsControl ItemsSource="{Binding Columns}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}" Width="66" Margin="2,0"
                                                                   FontWeight="SemiBold"
                                                                   Opacity="0.7" TextAlignment="Right"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontFamily="Cascadia Code,Consolas,Menlo,monospace" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <!-- data rows: label + aligned cells -->
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WorkbenchScoreRow">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Label}" Width="120"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <ItemsControl ItemsSource="{Binding Cells}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="x:String">
                                                                    <TextBlock Text="{Binding}" Width="66" Margin="2,0"
                                                                               TextAlignment="Right" Opacity="0.9"
                                                                               FontFamily="Cascadia Code,Consolas,Menlo,monospace" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Trace: pick a stat/highlight → the ticks/rounds/players where it fired -->
            <Border Grid.Column="4" BorderBrush="{DynamicResource BorderTranslucent}" BorderThickness="1"
                    CornerRadius="4">
                <DockPanel Margin="4">
                    <ComboBox DockPanel.Dock="Top" HorizontalAlignment="Stretch" MinHeight="28"
                              PlaceholderText="(evaluate, then pick a stat / highlight)"
                              ItemsSource="{Binding TraceTargets}"
                              SelectedItem="{Binding SelectedTraceTarget}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkbenchTraceTarget">
                                <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding TraceSummary}"
                               TextWrapping="Wrap" Opacity="0.75" Margin="2,4,2,4" />
                    <ListBox ItemsSource="{Binding TraceFires}" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkbenchTraceFire">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,2">
                                    <TextBlock Text="{Binding Tick, StringFormat='t{0}'}" Width="72"
                                               FontFamily="Cascadia Code,Consolas,Menlo,monospace" />
                                    <TextBlock Text="{Binding RoundLabel, StringFormat='r{0}'}" Width="40"
                                               Opacity="0.7" />
                                    <TextBlock Text="{Binding PlayerLabel}"
                                               TextTrimming="CharacterEllipsis" Opacity="0.9" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

        </Grid>

        <!-- Editor + node canvas (center) + data browser (right) -->
        <Grid ColumnDefinitions="*,4,300">

            <!-- The YAML editor and the node canvas SHARE this column rather than taking turns in
                 it. The canvas used to be a ColumnSpan=3 border with an opaque background, which
                 made the two surfaces alternating full-screen modes; design.md §9 decision 8 makes
                 them co-equal, because both author the same document and stay in sync. The canvas
                 column collapses to zero when the toggle is off (GraphPaneWidth), so nothing is left
                 holding space for a pane that is not there. -->
            <Grid Grid.Column="0" x:Name="EditorAndCanvas">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding GraphPaneWidth}" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" x:Name="EditorPane"
                        BorderBrush="{DynamicResource BorderTranslucent}" BorderThickness="1"
                        CornerRadius="4">
                    <ae:TextEditor x:Name="Editor"
                                   FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                   FontSize="13"
                                   ShowLineNumbers="True"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto" />
                </Border>

                <GridSplitter Grid.Column="1" Width="4" Background="Transparent"
                              ResizeDirection="Columns" IsVisible="{Binding ShowGraph}" />

                <!-- Canvas pane: see the ItemTemplate below for what a node is. -->
                <Border Grid.Column="2" x:Name="CanvasPane"
                        IsVisible="{Binding ShowGraph}"
                        BorderBrush="{DynamicResource BorderTranslucent}" BorderThickness="1"
                        CornerRadius="4">
                    <DockPanel Margin="4">
                        <TextBlock DockPanel.Dock="Top" Text="{Binding GraphSummary}"
                                   FontWeight="SemiBold" Opacity="0.7" Margin="2,2,2,6"
                                   TextTrimming="CharacterEllipsis" />

                        <!-- Node editing (design.md §6.4 item 4). Every button here produces a new
                             BUFFER through the splicing writer, so Save, dirty-tracking, the checker
                             and the canvas re-render all continue to work unchanged. -->
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6"
                                    Margin="2,0,2,6">
                            <Button Content="Add stat" Command="{Binding AddStatNodeCommand}"
                                    ToolTip.Tip="Append a new stat and select it" />
                            <Button Content="Delete" Command="{Binding DeleteSelectedNodeCommand}"
                                    ToolTip.Tip="Remove the selected stat or highlight" />
                            <Button Content="Undo" Command="{Binding UndoCommand}" />
                            <Button Content="Redo" Command="{Binding RedoCommand}" />
                        </StackPanel>

                        <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedNodeSummary}"
                                   Opacity="0.75" TextWrapping="Wrap" Margin="2,0,2,6" />

                        <!-- The selected node's fields. A blank value removes the key, which is the
                             only gesture a field editor has for taking an optional one back off. -->
                        <Border DockPanel.Dock="Bottom" MaxHeight="150" Margin="0,6,0,0"
                                IsVisible="{Binding CanEditSelectedNode}"
                                BorderBrush="{DynamicResource BorderTranslucent}" BorderThickness="1"
                                CornerRadius="4" Padding="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding SelectedNodeFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RulesetNodeField">
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Key}" FontSize="11" Opacity="0.7" />
                                                <TextBox Text="{Binding Value, Mode=OneTime}"
                                                         FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                                         Tag="{Binding}" KeyDown="OnNodeFieldKeyDown" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- The open ruleset drawn as real node controls, positioned by MSAGL rather
                             than by nodify, which has no layout of its own and whose own maintainer
                             recommends MSAGL for exactly this.

                             Nodes ARE the document: one per stats: or highlights: entry, wired by the
                             value references between siblings. Dragging and selection are on; a drag
                             moves the box for as long as the layout stands, and selecting a node
                             reveals the YAML that declares it. -->
                        <nodify:NodifyEditor x:Name="Canvas"
                                             ItemsSource="{Binding RulesetNodes}"
                                             Connections="{Binding RulesetConnections}"
                                             SelectedItem="{Binding SelectedRulesetNode, Mode=TwoWay}"
                                             DisableZooming="False" DisablePanning="False"
                                             EnableRealtimeSelection="False"
                                             CanSelectMultipleItems="False"
                                             ClipToBounds="True" MinHeight="240">
                            <nodify:NodifyEditor.ItemContainerTheme>
                                <ControlTheme TargetType="nodify:ItemContainer"
                                              BasedOn="{StaticResource {x:Type nodify:ItemContainer}}"
                                              x:DataType="vm:RulesetGraphNode">
                                    <Setter Property="Location" Value="{Binding Location}" />
                                    <!-- Dragging moves the box and NOTHING else. The arrangement is
                                         MSAGL's answer and lasts until the next render; the sidecar
                                         store that would keep it is design.md §6.7 staging item 4,
                                         and no gesture here writes one. -->
                                    <Setter Property="IsDraggable" Value="True" />
                                    <Setter Property="IsSelectable" Value="True" />
                                </ControlTheme>
                            </nodify:NodifyEditor.ItemContainerTheme>
                            <nodify:NodifyEditor.ItemTemplate>
                                <DataTemplate x:DataType="vm:RulesetGraphNode">
                                    <nodify:Node Width="200" Classes.projected="{Binding !IsEditable}"
                                                 ToolTip.Tip="{Binding Subtitle}">
                                        <nodify:Node.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <!-- Shape, not colour. A node this file declares
                                                     carries a pencil; one composed in through use: is
                                                     read-only here and carries the same lock the
                                                     toolbar puts on a shipped ruleset, is titled with
                                                     its owning ruleset, and is dimmed. Any one of the
                                                     three survives a greyscale screenshot. -->
                                                <TextBlock Text="✎" Opacity="0.85"
                                                           IsVisible="{Binding IsEditable}" />
                                                <TextBlock Text="🔒" Opacity="0.85"
                                                           IsVisible="{Binding !IsEditable}" />
                                                <TextBlock Text="{Binding Title}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </nodify:Node.Header>
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Subtitle}"
                                                       IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                       FontSize="10" Opacity="0.75"
                                                       TextTrimming="CharacterEllipsis" />
                                            <!-- on:/gate chips. These are what the trigger fires on,
                                                 and drawing them as wires instead is what gave the
                                                 old canvas its four lifecycle hubs. -->
                                            <ItemsControl ItemsSource="{Binding Value, Converter={x:Static rw:EventChipsConverter.Instance}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Margin="0,0,3,3" Padding="4,1"
                                                                CornerRadius="7"
                                                                BorderThickness="1"
                                                                BorderBrush="{DynamicResource BorderTranslucent}">
                                                            <TextBlock Text="{Binding}" FontSize="9"
                                                                       Opacity="0.85"
                                                                       FontFamily="Cascadia Code,Consolas,Menlo,monospace" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </nodify:Node>
                                </DataTemplate>
                            </nodify:NodifyEditor.ItemTemplate>
                            <nodify:NodifyEditor.ConnectionTemplate>
                                <DataTemplate x:DataType="vm:RulesetGraphConnection">
                                    <nodify:Connection Source="{Binding Source}" Target="{Binding Target}"
                                                       Text="{Binding Label}" />
                                </DataTemplate>
                            </nodify:NodifyEditor.ConnectionTemplate>
                        </nodify:NodifyEditor>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Background="Transparent" />

            <!-- Data browser: a vocabulary TREE (expand match → match.* → …) + live values, clearly split -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderTranslucent}" BorderThickness="1"
                    CornerRadius="4">
                <DockPanel Margin="6">

                    <!-- ── Live player values at the current frame (bottom section, clearly separated) ── -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderTranslucent}"
                            BorderThickness="0,1,0,0"
                            Margin="0,6,0,0" Padding="0,6,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Current frame — player values"
                                       FontWeight="SemiBold" Opacity="0.7" Margin="2,0,2,4" />
                            <ListBox Height="130" ItemsSource="{Binding LivePlayers}" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LivePlayerRow">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Name}" Width="110"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Team, StringFormat='T{0}'}" Opacity="0.6" />
                                            <TextBlock Text="{Binding Position}" Opacity="0.6"
                                                       FontFamily="Cascadia Code,Consolas,Menlo,monospace" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- ── Vocabulary tree (top/fill section) ── -->
                    <TextBlock DockPanel.Dock="Top" Text="Vocabulary — double-click a path to insert"
                               FontWeight="SemiBold" Opacity="0.7" Margin="2,0,2,4" TextWrapping="Wrap" />
                    <TreeView x:Name="PathsTree" ItemsSource="{Binding PathTree}" Background="Transparent">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="vm:WorkbenchPathNode">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Segment}"
                                               FontFamily="Cascadia Code,Consolas,Menlo,monospace" />
                                    <TextBlock Text="{Binding Category}" Opacity="0.35" VerticalAlignment="Center" />
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                </DockPanel>
            </Border>


        </Grid>

    </DockPanel>

</UserControl>