<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DemoViewer.NET.Modules.SuggestedTags"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="260"
             x:Class="DemoViewer.NET.Views.SuggestedTags.SuggestionQueueView"
             Focusable="False"
             x:DataType="vm:SuggestionQueueViewModel">

    <UserControl.Styles>
        <Style Selector="Border.row">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.row.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource Pb2dPositive}" />
        </Style>
        <Style Selector="TextBlock.confidence">
            <Setter Property="Foreground" Value="{DynamicResource Pb2dTextMid}" />
        </Style>
        <Style Selector="TextBlock.confidence.high">
            <Setter Property="Foreground" Value="{DynamicResource Pb2dPositive}" />
        </Style>
        <Style Selector="TextBlock.confidence.low">
            <Setter Property="Foreground" Value="{DynamicResource Pb2dTextDim}" />
        </Style>
    </UserControl.Styles>

    <!-- The Proposal Queue, docked under the Tag Palette. Like the palette, nothing here takes focus but
         the editor's boxes: the tab's tunnelling key handler owns J, K, Y, N, Enter and Ctrl+Y. -->
    <Border Padding="8,6" CornerRadius="4" Background="{DynamicResource Pb2dCardBg}">
        <StackPanel Spacing="4">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding HeaderText}" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource Pb2dTextBrightest}" />
                <TextBlock Grid.Column="1" Text=" · session only" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource Pb2dTextDim}" IsVisible="{Binding IsSessionOnly}"
                           ToolTip.Tip="Suggestions and verdicts live in memory on this host and are gone when the tab closes" />
                <Button Grid.Column="3" Content="Review" Padding="6,1" Margin="0,0,4,0" Focusable="False"
                        Command="{Binding ReviewCommand}"
                        ToolTip.Tip="Select the first suggestion: J and K then walk the queue, Y accepts, N rejects, Enter edits" />
                <Button Grid.Column="4" Content="Detect" Padding="6,1" Focusable="False"
                        Command="{Binding DetectCommand}"
                        ToolTip.Tip="Run the detectors over this demo now" />
            </Grid>

            <Grid ColumnDefinitions="*,Auto,Auto">
                <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" Focusable="False" FontSize="11"
                          ItemsSource="{Binding DetectorFilters}" SelectedItem="{Binding DetectorFilter}"
                          ToolTip.Tip="Show one detector's suggestions" />
                <TextBlock Grid.Column="1" Text="min" FontSize="10" Margin="8,0,4,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Pb2dTextDim}" />
                <Slider Grid.Column="2" Width="90" Minimum="0" Maximum="0.95" SmallChange="0.05" LargeChange="0.1"
                        TickFrequency="0.05" IsSnapToTickEnabled="True" Focusable="False"
                        Value="{Binding MinConfidence}"
                        ToolTip.Tip="Hide suggestions below this confidence; Ctrl+Y accepts only what is shown" />
            </Grid>

            <CheckBox Content="Detect for every demo in the background" FontSize="11" Focusable="False"
                      IsChecked="{Binding IsBackgroundOn}" IsVisible="{Binding !IsSessionOnly}"
                      ToolTip.Tip="Off, only the demo you open is searched for suggestions; on, every demo in the library with round facts is, as it is parsed" />

            <Border IsVisible="{Binding IsConfirmingAcceptAll}" Padding="6,4" CornerRadius="3"
                    Background="{DynamicResource Pb2dPanelBg}">
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding ConfirmText}" TextWrapping="Wrap" FontSize="11"
                               VerticalAlignment="Center" Foreground="{DynamicResource Pb2dTextBright}" />
                    <Button Grid.Column="1" Content="Accept" Padding="6,1" Margin="4,0" Focusable="False"
                            Command="{Binding ConfirmAcceptAllCommand}" />
                    <Button Grid.Column="2" Content="Cancel" Padding="6,1" Focusable="False"
                            Command="{Binding CancelAcceptAllCommand}" />
                </Grid>
            </Border>

            <!-- The editor: the proposal's window in seconds since freeze end and its labels as
                 group=value pairs. Enter saves (accepting it as edited), Esc returns without a verdict. -->
            <Border IsVisible="{Binding IsEditing}" Padding="6,4" CornerRadius="3"
                    Background="{DynamicResource Pb2dPanelBg}">
                <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="4">
                        <TextBlock Grid.Column="0" Text="from" FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Pb2dTextDim}" />
                        <TextBox Grid.Column="1" x:Name="EditFromBox" Text="{Binding EditFrom}" FontSize="11" />
                        <TextBlock Grid.Column="2" Text="to" FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Pb2dTextDim}" />
                        <TextBox Grid.Column="3" Text="{Binding EditTo}" FontSize="11" />
                    </Grid>
                    <TextBox Text="{Binding EditLabels}" FontSize="11" Watermark="labels: site=BombsiteA, tempo=rush" />
                    <TextBox Text="{Binding EditNote}" FontSize="11" Watermark="note (optional)" />
                    <TextBlock Text="Enter accepts with these changes, Esc goes back without a verdict" FontSize="10"
                               Foreground="{DynamicResource Pb2dTextDim}" />
                </StackPanel>
            </Border>

            <ScrollViewer MaxHeight="220">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SuggestionRowViewModel">
                            <Border Classes="row" Classes.selected="{Binding IsSelected}" Margin="0,0,0,3"
                                    Padding="6,3" CornerRadius="3" Background="{DynamicResource Pb2dPanelBg}"
                                    Tag="{Binding}" PointerPressed="OnRowPressed">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontSize="11">
                                        <Run Text="{Binding Title}" Foreground="{DynamicResource Pb2dTextBrightest}" />
                                        <Run Text="{Binding SideText}" Foreground="{DynamicResource Pb2dTextMid}" />
                                        <Run Text="{Binding RoundText}" Foreground="{DynamicResource Pb2dTextDim}" />
                                        <Run Text="{Binding SecondText}" Foreground="{DynamicResource Pb2dTextDim}" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Classes="confidence"
                                               Classes.high="{Binding IsHigh}" Classes.low="{Binding IsLow}"
                                               Text="{Binding ConfidenceText}" FontFamily="Consolas,Menlo,monospace"
                                               FontSize="11" Margin="6,0" VerticalAlignment="Center"
                                               ToolTip.Tip="{Binding FactorsText}" />
                                    <Button Grid.Row="0" Grid.Column="2" Content="✓" Padding="4,0" Focusable="False"
                                            Command="{Binding $parent[ItemsControl].((vm:SuggestionQueueViewModel)DataContext).AcceptRowCommand}"
                                            CommandParameter="{Binding}" ToolTip.Tip="Accept (Y)" />
                                    <Button Grid.Row="0" Grid.Column="3" Content="✕" Padding="4,0" Margin="2,0,0,0"
                                            Focusable="False"
                                            Command="{Binding $parent[ItemsControl].((vm:SuggestionQueueViewModel)DataContext).RejectRowCommand}"
                                            CommandParameter="{Binding}" ToolTip.Tip="Reject (N)" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Text="{Binding EvidenceText}"
                                               TextWrapping="Wrap" FontSize="10" IsVisible="{Binding IsSelected}"
                                               Foreground="{DynamicResource Pb2dTextMid}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="10"
                       Foreground="{DynamicResource Pb2dTextDim}"
                       IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </Border>
</UserControl>
