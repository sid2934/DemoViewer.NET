<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:stats="using:DemoViewer.NET.ViewModels.Stats"
             xmlns:local="using:DemoViewer.NET.Views.Stats"
             xmlns:output="using:CS2DemoKit.Analysis.Output"
             xmlns:controls="using:DemoViewer.NET.Controls"
             xmlns:statsCtl="using:DemoViewer.NET.Controls.Stats"
             controls:TutorialAnchor.Target="StatsContent"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="DemoViewer.NET.Views.Stats.StatsTabView"
             x:DataType="stats:StatsTabViewModel">

    <UserControl.Resources>
        <!-- Shared row template: team-colored bullet + player identity (UI font), then one cell per
             stat column — width/alignment/emphasis all driven by the cell's ColumnCatalogue meta.
             Serves scoreboard section rows, per-team totals rows, and the flat Rounds rows. -->
        <DataTemplate x:Key="StatsRowTemplate" x:DataType="stats:StatsRow">
            <!-- Double-tap / context-menu "Details" open the player-details overlay.
                 Both go through code-behind — Avalonia exposes DoubleTapped as a routed event, not
                 a bindable command, and pulling in Behaviors for it is a forbidden new dependency.
                 Totals rows are guarded in the command (no slot). -->
            <Border Classes="statsRow"
                    Classes.alt="{Binding IsAlt}"
                    Classes.totals="{Binding IsTotals}"
                    DoubleTapped="OnRowDoubleTapped">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Details"
                                  IsEnabled="{Binding !IsTotals}"
                                  Click="OnRowDetailsClick" />
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Width="200">
                        <TextBlock Text="{Binding Bullet}" Width="16" FontSize="9"
                                   VerticalAlignment="Center"
                                   Classes="statsBullet"
                                   Classes.ct="{Binding IsCt}" />
                        <TextBlock Text="{Binding PlayerName}" Classes="statsPlayer"
                                   Classes.totals="{Binding IsTotals}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="stats:StatCell">
                                <!-- One StatValue per cell (v0.8.1). Text comes from the cell so the board
                                     keeps its own formatting (bools still render as a tick); the control
                                     only draws. An unscaled column passes Scale=null and renders exactly as
                                     the TextBlock did, which is what keeps this additive across all 74
                                     catalogued columns and every user-authored one. -->
                                <statsCtl:StatValue Text="{Binding Display}"
                                                    Value="{Binding Numeric}"
                                                    Scale="{Binding Scale}"
                                                    IsLeader="{Binding IsLeader}"
                                                    Width="{Binding Width}"
                                                    TextAlignment="{Binding Alignment}"
                                                    Classes="statsCell"
                                                    Classes.pos="{Binding IsPositive}"
                                                    Classes.neg="{Binding IsNegative}"
                                                    ToolTip.Tip="{Binding Tooltip}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Stats tab (release plan P1-3.1/4.1): the USER-facing scoreboard over the same MetricTables
         the export writes. Hand-rolled columnar list per the house pattern (EntityListView) — the
         column set is dynamic (follows the loaded rules), so header and cells are ItemsControls
         sharing one fixed column width instead of a fixed-AXAML Grid. -->
    <Border Background="{DynamicResource PanelBg}">
        <!-- Rows: toolbar | category rail | podium | body. -->
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- ── Toolbar: view switch, per-view context, status and export, in ONE band ──
                 This used to be two stacked bars. Three bands of similar weight sat above the data
                 (view switch, context, category tabs) and none of them read as the primary one.
                 Collapsing the first two recovers about 40px and leaves a single primary nav. -->
            <Border Grid.Row="0"
                    Background="{DynamicResource PanelHeaderBg}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0 0 0 1"
                    Padding="16 9">
                <DockPanel LastChildFill="True">

                    <!-- Export sits quietly at the far right: it is an action on the page, not part
                         of navigating it. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center">
                        <Button Content="Export CSV"
                                Click="OnExportCsvClick"
                                IsEnabled="{Binding HasStats}"
                                Classes="statsexport"
                                ToolTip.Tip="Export every stats table as CSV to a folder" />
                        <Button Content="JSON"
                                Click="OnExportJsonClick"
                                IsEnabled="{Binding HasStats}"
                                Classes="statsexport"
                                ToolTip.Tip="Export every stats table as JSON to a folder" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <ToggleButton Content="Scoreboard"
                                      IsChecked="{Binding IsMatchView, Mode=OneWay}"
                                      Command="{Binding ShowMatchViewCommand}"
                                      Classes="statsview"
                                      ToolTip.Tip="End-of-match scoreboard (one row per player)" />
                        <ToggleButton Content="Rounds"
                                      IsChecked="{Binding IsRoundView, Mode=TwoWay}"
                                      Classes="statsview"
                                      ToolTip.Tip="Per-round breakdown" />
                        <ToggleButton Content="Highlights"
                                      IsChecked="{Binding IsHighlightsView, Mode=TwoWay}"
                                      Classes="statsview"
                                      ToolTip.Tip="Chain satisfactions: multi-kills, clutches, and any user-defined achievement chains" />
                        <ToggleButton Content="Vision"
                                      IsChecked="{Binding IsVisibilityView, Mode=TwoWay}"
                                      IsVisible="{Binding HasVisibilityStats}"
                                      Classes="statsview"
                                      ToolTip.Tip="3D line-of-sight stats: time exposed to / could see enemies (recomputed LOS, not the spotted bit)" />

                        <!-- Power-user overflow: any declared outputs:/keyed table this evaluation produced. -->
                        <ComboBox ItemsSource="{Binding ExtraTables}"
                                  SelectedItem="{Binding SelectedExtraTable, Mode=TwoWay}"
                                  IsVisible="{Binding HasExtraTables}"
                                  PlaceholderText="More"
                                  MinWidth="110" Margin="6 0 0 0" FontSize="12"
                                  ToolTip.Tip="Declared outputs and keyed breakdowns (e.g. per-weapon kills)">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="output:MetricTable">
                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Rectangle Classes="divider" Width="1" Height="18" Margin="8 0" />

                        <!-- Rounds: round stepper -->
                        <StackPanel Orientation="Horizontal" Spacing="3"
                                    IsVisible="{Binding IsRoundView}">
                            <Button Content="&#x25C0;" Command="{Binding PrevRoundCommand}"
                                    Classes="statsexport" ToolTip.Tip="Previous round" />
                            <ComboBox ItemsSource="{Binding Rounds}"
                                      SelectedItem="{Binding SelectedRound, Mode=TwoWay}"
                                      MinWidth="72" FontSize="12"
                                      ToolTip.Tip="Round number" />
                            <Button Content="&#x25B6;" Command="{Binding NextRoundCommand}"
                                    Classes="statsexport" ToolTip.Tip="Next round" />
                        </StackPanel>

                        <!-- Vision: one-time compute action + busy -->
                        <Button Content="Compute visibility"
                                Command="{Binding ComputeVisibilityCommand}"
                                IsVisible="{Binding CanComputeVisibility}"
                                IsEnabled="{Binding !IsComputingVisibility}"
                                Classes="statsexport"
                                ToolTip.Tip="One-time 3D line-of-sight replay over the whole demo (a few seconds); adds the visibility tables to the view and the export" />
                        <ProgressBar IsIndeterminate="True"
                                     IsVisible="{Binding IsComputingVisibility}"
                                     Width="90" Height="4"
                                     VerticalAlignment="Center" />

                        <TextBlock Text="{Binding StatusMessage}"
                                   Classes="statsStatus" MaxWidth="420"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ── Category sub-rail: one chip per StatGroup in the active view;
                     visible columns = Core anchor ∪ selected group. Table views only. ── -->
            <StackPanel Grid.Row="1">
                <Border Background="{DynamicResource PanelHeaderBg}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="0 0 0 1"
                        Padding="10 0"
                        IsVisible="{Binding IsTableView}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="stats:CategoryChip">
                                    <Button Content="{Binding Label}"
                                            Command="{Binding $parent[ItemsControl].((stats:StatsTabViewModel)DataContext).SelectCategoryCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="statscat"
                                            Classes.selected="{Binding IsSelected}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Board-level "these cells have no data" band. It sits directly over the table, because
                     that is where the zeros were: seventeen columns come from the line-of-sight pass, and
                     on a map with no collision geometry seven of the eight on the Aim Quality board read a
                     hard 0 that looked exactly like a measurement. Wraps rather than trims, since the
                     sentence naming the affected columns is the whole value of it. -->
                <Border Background="{DynamicResource PanelBg}"
                        BorderBrush="{DynamicResource AccentAmber}"
                        BorderThickness="0 0 0 1"
                        Padding="12 7"
                        IsVisible="{Binding HasSightNotice}">
                    <TextBlock Text="{Binding SightNotice}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource TextMid}" />
                </Border>
            </StackPanel>

            <!-- ── Extra table (F2/F3): generic renderer for any picked outputs:/keyed table —
                     dimension columns then value columns, cells preformatted by the VM ── -->
            <ScrollViewer Grid.Row="3"
                          IsVisible="{Binding IsExtraTableView}"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Background="{DynamicResource PanelHeaderBg}"
                            BorderBrush="{DynamicResource BorderStrong}"
                            BorderThickness="0 0 0 1">
                        <ItemsControl ItemsSource="{Binding ExtraColumns}" Margin="10 0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" Width="120"
                                               Classes="statsHead" Padding="0 4"
                                               ToolTip.Tip="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ExtraRows}" Margin="10 2">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding}" Margin="0 1">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}" Width="120"
                                                           Classes="statsCell"
                                                           Foreground="{DynamicResource TextEntityFieldVal}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </ScrollViewer>

            <!-- ── Table (one horizontal scroll owns header + rows so they stay aligned;
                     rows scroll vertically inside) ──────────────────────────── -->
            <!-- ── Highlights: the chain-satisfaction log (achievements view) ── -->
            <ScrollViewer Grid.Row="3"
                          IsVisible="{Binding IsHighlightsView}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Highlights}" Margin="14 6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="stats:HighlightRow">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0 1">
                                <TextBlock Text="{Binding RoundLabel}" Width="80"
                                           Classes="statsCell"
                                           Foreground="{DynamicResource TextMid}" />
                                <TextBlock Text="{Binding Tick, StringFormat='tick {0}'}" Width="110"
                                           Classes="statsCell"
                                           Foreground="{DynamicResource TextDimGray}" />
                                <TextBlock Text="{Binding Player}" Width="170"
                                           Classes="statsCell"
                                           Foreground="{DynamicResource TextBright}" />
                                <TextBlock Text="{Binding Chain}"
                                           Classes="statsCell"
                                           Foreground="{DynamicResource TextBright}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ══ 3D visibility view (F4): per-player LOS table; the directed pairs
                     table ships in the export alongside it ══ -->
            <Grid Grid.Row="3"
                  RowDefinitions="Auto,*"
                  IsVisible="{Binding IsVisibilityView}"
                  Margin="14 6">
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource BorderStrong}"
                        BorderThickness="0 0 0 1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="player" Width="170" Classes="statsHead" />
                        <TextBlock Text="team" Width="40" Classes="statsHead" />
                        <TextBlock Text="exposed" Width="92" Classes="statsHead"
                                   ToolTip.Tip="Time at least one enemy had a clear 3D line of sight to this player" />
                        <TextBlock Text="seen enemy" Width="92" Classes="statsHead"
                                   ToolTip.Tip="Time this player had at least one enemy on screen (clear LOS, in FOV, not smoked)" />
                        <TextBlock Text="exposed %" Width="92" Classes="statsHead"
                                   ToolTip.Tip="Exposed time as a share of the sampled match time" />
                        <TextBlock Text="vision %" Width="92" Classes="statsHead"
                                   ToolTip.Tip="Seen-enemy time as a share of the sampled match time" />
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding VisibilityRows}" Margin="0 2">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="stats:VisibilityRow">
                                <StackPanel Orientation="Horizontal" Margin="0 1">
                                    <TextBlock Text="{Binding PlayerName}" Width="170"
                                               Classes="statsCell"
                                               Foreground="{DynamicResource TextBright}" />
                                    <TextBlock Text="{Binding TeamLabel}" Width="40"
                                               Classes="statsCell"
                                               Foreground="{DynamicResource TextMid}" />
                                    <TextBlock Text="{Binding ExposedDisplay}" Width="92"
                                               Classes="statsCell"
                                               Foreground="{DynamicResource TextEntityFieldVal}" />
                                    <TextBlock Text="{Binding CouldSeeDisplay}" Width="92"
                                               Classes="statsCell"
                                               Foreground="{DynamicResource TextEntityFieldVal}" />
                                    <TextBlock Text="{Binding ExposedShareDisplay}" Width="92"
                                               Classes="statsCell"
                                               Foreground="{DynamicResource TextEntityFieldVal}" />
                                    <TextBlock Text="{Binding VisionShareDisplay}" Width="92"
                                               Classes="statsCell"
                                               Foreground="{DynamicResource TextEntityFieldVal}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <!-- ══ end 3D visibility view (F4) ══ -->

            <!-- ── Scoreboard / Rounds: one horizontal scroll owns header + rows (alignment);
                     Scoreboard renders CT/T team sections with totals, Rounds a flat round view ── -->
            <!-- ── Podium: the match's top three by rating, across BOTH teams ──────────────
                 A strip rather than three cards. The reference fills its cards with a portrait and
                 agent art; this app has no avatar pipeline (no HTTP client, no Steam Web API, no
                 image cache), so three tall cards would be three portrait-shaped holes. The ring
                 shows the HLTV rating ITSELF, not a delta: the reference's +11.96 is a delta against
                 their own baseline, and we have no such baseline to subtract. -->
            <Border Grid.Row="2"
                    Background="{DynamicResource PanelBg}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0 0 0 1"
                    Padding="16 10"
                    IsVisible="{Binding IsPodiumVisible}">
                <ItemsControl ItemsSource="{Binding Podium}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="22" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="stats:PodiumEntry">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RankLabel}" Classes="podiumRank"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="●" Classes="statsBullet" FontSize="9"
                                           Classes.ct="{Binding IsCt}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" Classes="podiumName"
                                           VerticalAlignment="Center" />
                                <statsCtl:RingGauge Value="{Binding Rating}"
                                                    Scale="{Binding Scale}"
                                                    Format="0.00"
                                                    Width="46" Height="46" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- The board sits on its own raised surface rather than directly on the panel.
                 A table with no container reads as part of the chrome; a card reads as content. -->
            <Border Grid.Row="3"
                    Classes="boardCard"
                    IsVisible="{Binding IsColumnTable}">
            <!-- The header and the body are SIBLING scrollers whose horizontal offsets are synced
                 in code-behind, not a vertical scroller nested inside a horizontal one.

                 Nested, the inner vertical scroller is laid out at the full CONTENT width (1880px on a
                 wide category) rather than at the viewport width, which parks its scrollbar permanently
                 off-screen: the Other page had eight columns, five visible, and no way to reach the
                 rest. Siblings each get a correctly-sized viewport, so both scrollbars land where they
                 belong and the column header still stays put while the rows scroll under it. -->
            <Grid RowDefinitions="Auto,*">
                <ScrollViewer Grid.Row="0"
                              Name="HeaderScroll"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">

                    <!-- header: sortable player column + per-column header (name + sort glyph) -->
                    <Border
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderSubtle}"
                            BorderThickness="0 0 0 1">
                        <StackPanel Orientation="Horizontal" Margin="16 0">
                            <Button Width="200"
                                    Command="{Binding SortByPlayerCommand}"
                                    Classes="statsHeadBtn" VerticalAlignment="Bottom"
                                    ToolTip.Tip="Sort by player name">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="Player" Classes="statsHeadText" />
                                    <TextBlock Text="{Binding PlayerSortGlyph}" Classes="statsHeadGlyph" />
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding CurrentColumns}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="stats:StatColumn">
                                        <Button Width="{Binding Width}"
                                                Command="{Binding $parent[ItemsControl].((stats:StatsTabViewModel)DataContext).SortByColumnCommand}"
                                                CommandParameter="{Binding}"
                                                Classes="statsHeadBtn"
                                                Classes.sorted="{Binding IsSorted}"
                                                ToolTip.Tip="{Binding Tooltip}">
                                            <!-- Group-band label suppressed — the category chip
                                                 already names the group. -->
                                            <StackPanel Orientation="Horizontal" Spacing="1"
                                                        HorizontalAlignment="Right" Margin="0 0 14 0">
                                                <TextBlock Text="{Binding Display}" Classes="statsHeadText" />
                                                <TextBlock Text="{Binding SortGlyph}" Classes="statsHeadGlyph" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </ScrollViewer>

                    <!-- rows -->
                    <ScrollViewer Grid.Row="1"
                                  Name="BodyScroll"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  AllowAutoHide="False">
                        <Panel Margin="16 6">
                            <!-- Scoreboard: CT/T sections, zebra rows, per-team totals -->
                            <ItemsControl ItemsSource="{Binding TeamSections}"
                                          IsVisible="{Binding IsMatchView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="stats:TeamSection">
                                        <StackPanel Margin="0 0 0 8">
                                            <!-- "ENDED CT", not "CT". Teams swap sides at half, so a
                                                 bare side name beside a TEAM total is the pairing the
                                                 Match Overview page was rewritten to eliminate. The
                                                 WIN/LOSS pill is absent unless the scoreline is
                                                 plausible: a buzzer-truncated demo can report a false
                                                 tie, and claiming a draw on a match somebody won is
                                                 worse than claiming nothing. -->
                                            <statsCtl:TeamBadge Team="{Binding Team}"
                                                                Label="{Binding TeamLabel}"
                                                                Outcome="{Binding Outcome}"
                                                                Detail="{Binding ScoreText}"
                                                                HorizontalAlignment="Left"
                                                                Margin="0 2" />
                                            <ItemsControl ItemsSource="{Binding Rows}"
                                                          ItemTemplate="{StaticResource StatsRowTemplate}" />
                                            <ContentControl Content="{Binding Totals}"
                                                            ContentTemplate="{StaticResource StatsRowTemplate}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Rounds: flat team-ordered rows for the selected round -->
                            <ItemsControl ItemsSource="{Binding RoundRows}"
                                          ItemTemplate="{StaticResource StatsRowTemplate}"
                                          IsVisible="{Binding IsRoundView}" />
                        </Panel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══ Non-table category boards ═══════════════════════════════════════════════════
                 Some groups of columns are not a list of numbers, they are one shape counted several
                 ways, and a table makes the reader reassemble it. Utility and Weapons are a
                 COMPOSITION (what, and how much); Opening Duels is a CONTEST (won against lost, out of
                 attempts); Multi-kills and Objectives are small ORDINAL counts where a numeric column
                 is mostly whitespace and zero looks like one.

                 Every board keeps the whole lobby on screen and keeps the team sectioning, so it is
                 still the same page: only the form of the middle column changes. -->
            <Border Grid.Row="3"
                    Classes="boardCard"
                    IsVisible="{Binding IsBoardLayout}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16 12">

                        <!-- These forms are less conventional than a table, and a shape nobody can
                             read is worse than the table it replaced. -->
                        <DockPanel Margin="0 0 0 12">
                            <!-- The key IS a SegmentedBar, so it cannot disagree with the bars it
                                 explains: same control, same slot palette, equal-width segments. -->
                            <statsCtl:SegmentedBar DockPanel.Dock="Right"
                                                   Segments="{Binding BoardLegend}"
                                                   IsVisible="{Binding HasBoardLegend}"
                                                   Width="330" Height="20" Gap="2" FontSize="10"
                                                   VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BoardCaption}" Classes="boardCaption"
                                       Margin="0" VerticalAlignment="Center" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding BoardSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="stats:BoardSection">
                                    <StackPanel Margin="0 0 0 16">
                                        <statsCtl:TeamBadge Team="{Binding Team}"
                                                            Label="{Binding TeamLabel}"
                                                            Outcome="{Binding Outcome}"
                                                            Detail="{Binding ScoreText}"
                                                            HorizontalAlignment="Left"
                                                            Margin="0 0 0 6" />
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.DataTemplates>

                                                <!-- Composition: bar LENGTH is volume (shared scale
                                                     across the lobby), the split is the mix. -->
                                                <DataTemplate x:DataType="stats:CompositionRow">
                                                    <Grid ColumnDefinitions="234,*,54" Margin="0 5"
                                                          Classes="boardRow">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                    Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="●" FontSize="9"
                                                                       Classes="statsBullet"
                                                                       Classes.ct="{Binding IsCt}"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding PlayerName}"
                                                                           Classes="statsPlayer" />
                                                                <TextBlock Text="{Binding Detail}"
                                                                           Classes="boardDetail" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <statsCtl:SegmentedBar Grid.Column="1"
                                                                               Segments="{Binding Segments}"
                                                                               MaxTotal="{Binding MaxTotal}"
                                                                               Height="24" Gap="2"
                                                                               VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding TotalText}"
                                                                   Classes="boardTotal" />
                                                    </Grid>
                                                </DataTemplate>

                                                <!-- Diverging: losses left of the line, wins right,
                                                     both on one shared half-scale. The rate is shown
                                                     but flagged when too few duels back it. -->
                                                <DataTemplate x:DataType="stats:DuelRow">
                                                    <Grid ColumnDefinitions="234,*,46,64" Margin="0 5"
                                                          Classes="boardRow">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                    Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="●" FontSize="9"
                                                                       Classes="statsBullet"
                                                                       Classes.ct="{Binding IsCt}"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding PlayerName}"
                                                                           Classes="statsPlayer" />
                                                                <TextBlock Text="{Binding VolumeText}"
                                                                           Classes="boardDetail" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <statsCtl:DivergingBar Grid.Column="1"
                                                                               Negative="{Binding Lost}"
                                                                               Positive="{Binding Won}"
                                                                               Extent="{Binding Extent}"
                                                                               VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding NetText}"
                                                                   Classes="boardTotal" />
                                                        <TextBlock Grid.Column="3"
                                                                   Text="{Binding RateText}"
                                                                   Classes="boardRate"
                                                                   Classes.unreliable="{Binding LowVolume}"
                                                                   ToolTip.Tip="Opening-duel win rate. Below eight duels this is not a meaningful number, and is dimmed." />
                                                    </Grid>
                                                </DataTemplate>

                                                <!-- Pips: one mark per round. -->
                                                <DataTemplate x:DataType="stats:PipsRow">
                                                    <Grid ColumnDefinitions="234,*" Margin="0 5"
                                                          Classes="boardRow">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                    Spacing="8" VerticalAlignment="Center">
                                                            <TextBlock Text="●" FontSize="9"
                                                                       Classes="statsBullet"
                                                                       Classes.ct="{Binding IsCt}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding PlayerName}"
                                                                       Classes="statsPlayer"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <ItemsControl Grid.Column="1"
                                                                      ItemsSource="{Binding Groups}"
                                                                      VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="stats:PipGroup">
                                                                    <StackPanel Width="92" Spacing="2">
                                                                        <TextBlock Text="{Binding Label}"
                                                                                   Classes="boardPipLabel" />
                                                                        <statsCtl:PipStrip
                                                                            Count="{Binding Count}"
                                                                            Classes.good="{Binding IsGood}"
                                                                            Classes.rare="{Binding IsRare}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </DataTemplate>

                                            </ItemsControl.DataTemplates>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- empty state -->
            <TextBlock Grid.Row="3"
                       Text="{Binding StatusMessage}"
                       IsVisible="{Binding !HasStats}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="{DynamicResource TextDimGray}" />

            <!-- ── Player-details overlay (docs/ui/player-details-ux-design.md): spans the whole
                     tab so the scoreboard underneath is fully occluded and non-interactive while
                     its state (sort/category/scroll) stays frozen. Inline overlay, never a Window
                     (WASM parity). Esc closes; opened from a row double-tap / context menu. ── -->
            <Border Grid.Row="0" Grid.RowSpan="4"
                    x:Name="PlayerDetailsHost"
                    Background="{DynamicResource ShellBg}"
                    IsVisible="{Binding IsPlayerDetailsOpen}"
                    Focusable="True">
                <Border.KeyBindings>
                    <KeyBinding Gesture="Escape" Command="{Binding ClosePlayerDetailsCommand}" />
                </Border.KeyBindings>
                <local:PlayerDetailsView DataContext="{Binding PlayerDetails}" />
            </Border>
        </Grid>
    </Border>

    <UserControl.Styles>
        <!--
            v0.8.1 visual pass. The page was monospace at 10-11px throughout, including player names
            and section labels, on 21px zebra-striped rows with no surface separation. That reads as a
            terminal. It now runs in the app's proportional UI face with `tnum` on every number, so the
            columns still line up on the digit while names and labels become legible at a glance.
        -->
        <Style Selector="TextBlock.statsHead">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextLabel}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.statsHeadText">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextLabelAlt}" />
        </Style>
        <!-- Toolbar status line: present but never competing with the navigation beside it. -->
        <Style Selector="TextBlock.statsStatus">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimGray}" />
        </Style>
        <!-- The board's own surface. Raised off the panel, so the table reads as content rather
             than as more chrome. -->
        <Style Selector="Border.boardCard">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Margin" Value="14 10 14 14" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="TextBlock.statsHeadGlyph">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource AccentInteractive}" />
        </Style>
        <Style Selector="Button.statsHeadBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0 10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.statsHeadBtn.sorted TextBlock.statsHeadText">
            <Setter Property="Foreground" Value="{DynamicResource AccentInteractive}" />
        </Style>
        <!-- The plain-text cell, still used by the keyed extra tables, Highlights and Vision, which
             hold pre-formatted strings and have no scale to draw. Tabular figures here too, or the
             numeric ones among them stop lining up. -->
        <Style Selector="TextBlock.statsCell">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFeatures" Value="tnum" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextEntityFieldVal}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.statsCell.pos">
            <Setter Property="Foreground" Value="{DynamicResource StatPositive}" />
        </Style>
        <Style Selector="TextBlock.statsCell.neg">
            <Setter Property="Foreground" Value="{DynamicResource AccentError}" />
        </Style>
        <!-- The scoreboard cell. Same class name, different type: TextBlock.statsCell above still
             serves the extra-table / highlights / vision lists, which hold pre-formatted strings and
             have no scale to draw. Padding is the column gutter, and the bar respects it. -->
        <Style Selector="statsCtl|StatValue.statsCell">
            <Setter Property="Padding" Value="0 6 14 6" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="3" />
            <!-- Tabular figures. The board runs in the proportional UI face now, and without tnum a
                 column of numbers stops lining up under itself. -->
            <Setter Property="FontFeatures" Value="tnum" />
        </Style>
        <!-- Emphasis fallback for columns with no scale. StatValue paints no foreground when its
             sentiment is neutral, so setting Foreground here is enough and the two never fight.
             `.neg` moves off AccentError to the stat-specific token: a bad stat is a judgement, an
             error is a fault. -->
        <Style Selector="statsCtl|StatValue.statsCell.pos">
            <Setter Property="Foreground" Value="{DynamicResource StatPositive}" />
        </Style>
        <Style Selector="statsCtl|StatValue.statsCell.neg">
            <Setter Property="Foreground" Value="{DynamicResource StatNegative}" />
        </Style>
        <!-- Team-side bullet: T amber, CT blue (foreground must come from styles, not a local
             value, or the .ct class can never override it). -->
        <Style Selector="TextBlock.statsBullet">
            <Setter Property="Foreground" Value="{DynamicResource AccentAmber}" />
        </Style>
        <Style Selector="TextBlock.statsBullet.ct">
            <Setter Property="Foreground" Value="{DynamicResource AccentInteractive}" />
        </Style>
        <!-- Player identity reads in the UI font, not monospace. -->
        <Style Selector="TextBlock.statsPlayer">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- Totals read as a quiet summary line, not as an italic aside. -->
        <Style Selector="TextBlock.statsPlayer.totals">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextLabel}" />
        </Style>
        <!-- Row chrome. Zebra striping is GONE: it was a workaround for rows too tight to track
             across, and at 32px with a hairline separator the eye does not need a second cue. It also
             fought the cell bars, which are themselves a background fill. -->
        <Style Selector="Border.statsRow">
            <Setter Property="Padding" Value="0 3" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
        </Style>
        <!-- Kept as a no-op so IsAlt stays bound and the zebra can be reinstated by value alone. -->
        <Style Selector="Border.statsRow.alt">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.statsRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource PanelHeaderHover}" />
        </Style>
        <Style Selector="Border.statsRow.totals">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="0 1 0 0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="0 4 0 0" />
        </Style>
        <!-- The teamHeader / teamHeaderText styles are gone with the markup that used them: the
             section header is a stats:TeamBadge now, and its colours live in Styles/Stats.axaml. -->
        <Style Selector="ToggleButton.statsview, Button.statsexport">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12 5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <!-- Category chips: visually distinct PILLS — bordered, rounded, hover
             feedback; the selected chip fills with the interactive accent. One weight lighter than
             the view rail so the sub-rail still reads as secondary navigation. -->
        <!-- Non-table category boards. -->
        <Style Selector="TextBlock.boardCaption">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="Margin" Value="0 0 0 12" />
        </Style>
        <Style Selector="Grid.boardRow">
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="TextBlock.boardDetail">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextLabel}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.boardTotal">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFeatures" Value="tnum" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10 0 0 0" />
        </Style>
        <Style Selector="TextBlock.boardRate">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontFeatures" Value="tnum" />
            <Setter Property="Foreground" Value="{DynamicResource TextEntityFieldVal}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10 0 0 0" />
        </Style>
        <!-- A rate the volume cannot support is dimmed rather than hidden: the number is real, the
             conclusion people would draw from it is not. -->
        <Style Selector="TextBlock.boardRate.unreliable">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <Style Selector="TextBlock.boardPipLabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextLabel}" />
        </Style>

        <!-- Podium strip. -->
        <Style Selector="TextBlock.podiumRank">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextLabel}" />
        </Style>
        <Style Selector="TextBlock.podiumName">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxWidth" Value="170" />
        </Style>

        <!-- Category sub-navigation. Underlined tabs rather than the filled pills these used to be:
             a row of filled pills competes with the board's own bars and chips for attention, and
             this rail is navigation, not data. The selected tab carries an accent underline and
             brighter text; nothing else is filled. -->
        <Style Selector="Button.statscat">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="12 7" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0 0 0 2" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.statscat:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextMid}" />
        </Style>
        <Style Selector="Button.statscat.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentInteractive}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

</UserControl>