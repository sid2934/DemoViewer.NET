<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DemoViewer.NET.ViewModels.StratBook"
             xmlns:sb="using:DemoViewer.NET.Views.StratBook"
             xmlns:canvas="using:DemoViewer.NET.Modules.StratBook.Canvas"
             x:Class="DemoViewer.NET.Views.StratBook.StratBookTabView"
             x:DataType="vm:StratBookTabViewModel">

    <!--
      THE STRAT BOOK TAB: the book selector (me plus every Team Identity team, us first), the map and side
      filters and the strat list on the left; the open strat's editor on the right: metadata, the five slots,
      the step table on the round clock and the branches, with the session's status line, save, undo and redo.

      Text fields write on focus loss, so one field edit is one undo entry. Ctrl+Z and Ctrl+Shift+Z undo and
      redo the strat while the tab has focus.

      Colour: every value is a {DynamicResource} token; state is carried by words, never by tint.
    -->

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <!-- Role View's context lines (strat-model.md §3.14): another slot's step kept for context,
             greyed the way the printed page's ".context" class is. -->
        <Style Selector="TextBlock.roleLine">
            <Setter Property="Foreground" Value="{DynamicResource TextValue}" />
        </Style>
        <!-- The Detected preview's step list: the step the canvas is playing reads heavier, beside its "now". -->
        <Style Selector="TextBlock.previewStep">
            <Setter Property="Foreground" Value="{DynamicResource TextValue}" />
        </Style>
        <Style Selector="TextBlock.previewStep.previewStepActive">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.roleLine.roleLineContext">
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <!-- A label over its field: the step row's and the metadata's wrapping fields. -->
        <Style Selector="StackPanel.stratField">
            <Setter Property="Spacing" Value="2" />
        </Style>
        <Style Selector="StackPanel.stratField ComboBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="StackPanel.stratField TextBox">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.stratFieldLabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextMid}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- One row of the Strat Record Panel (strat-model.md §3.6): a scope's run/won/lost/aborted/unknown
             counts, each a button when its clips are nonempty, and the win rate. Shared by the total row
             and the provenance rows so both read the same. -->
        <DataTemplate x:Key="RecordSplitRowTemplate" x:DataType="vm:StratRecordSplitRow">
            <Grid ColumnDefinitions="*,32,32,32,32,32,64" ColumnSpacing="4" Margin="0 0 0 3">
                <TextBlock Grid.Column="0" Text="{Binding Display}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextValue}" TextTrimming="CharacterEllipsis" />
                <Panel Grid.Column="1">
                    <Button Classes="ghost" FontSize="11" Padding="6 2" Content="{Binding Run.CountText}"
                            Command="{Binding Run.OpenCommand}" IsVisible="{Binding !Run.IsEmpty}" ToolTip.Tip="{Binding Run.Tip}" />
                    <TextBlock Text="0" FontSize="11" Foreground="{DynamicResource TextMid}" IsVisible="{Binding Run.IsEmpty}" />
                </Panel>
                <Panel Grid.Column="2">
                    <Button Classes="ghost" FontSize="11" Padding="6 2" Content="{Binding Won.CountText}"
                            Command="{Binding Won.OpenCommand}" IsVisible="{Binding !Won.IsEmpty}" ToolTip.Tip="{Binding Won.Tip}" />
                    <TextBlock Text="0" FontSize="11" Foreground="{DynamicResource TextMid}" IsVisible="{Binding Won.IsEmpty}" />
                </Panel>
                <Panel Grid.Column="3">
                    <Button Classes="ghost" FontSize="11" Padding="6 2" Content="{Binding Lost.CountText}"
                            Command="{Binding Lost.OpenCommand}" IsVisible="{Binding !Lost.IsEmpty}" ToolTip.Tip="{Binding Lost.Tip}" />
                    <TextBlock Text="0" FontSize="11" Foreground="{DynamicResource TextMid}" IsVisible="{Binding Lost.IsEmpty}" />
                </Panel>
                <Panel Grid.Column="4">
                    <Button Classes="ghost" FontSize="11" Padding="6 2" Content="{Binding Aborted.CountText}"
                            Command="{Binding Aborted.OpenCommand}" IsVisible="{Binding !Aborted.IsEmpty}" ToolTip.Tip="{Binding Aborted.Tip}" />
                    <TextBlock Text="0" FontSize="11" Foreground="{DynamicResource TextMid}" IsVisible="{Binding Aborted.IsEmpty}" />
                </Panel>
                <Panel Grid.Column="5">
                    <Button Classes="ghost" FontSize="11" Padding="6 2" Content="{Binding Unknown.CountText}"
                            Command="{Binding Unknown.OpenCommand}" IsVisible="{Binding !Unknown.IsEmpty}" ToolTip.Tip="{Binding Unknown.Tip}" />
                    <TextBlock Text="0" FontSize="11" Foreground="{DynamicResource TextMid}" IsVisible="{Binding Unknown.IsEmpty}" />
                </Panel>
                <TextBlock Grid.Column="6" Text="{Binding WinRateText}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMid}" />
            </Grid>
        </DataTemplate>
        <!-- The callout alias editor: under the strat list, and in the header flyout while the list is collapsed. -->
        <DataTemplate x:Key="CalloutsEditorTemplate" x:DataType="vm:CalloutsEditorViewModel">
            <StackPanel Spacing="6">
                <TextBlock Text="Callouts" Classes="col-label"
                           Foreground="{DynamicResource TextCardHeader}" FontSize="11" />
                <TextBlock Text="pick one map (not all maps) to edit its aliases" FontSize="11"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextMid}" IsVisible="{Binding !HasMap}" />
                <StackPanel Spacing="6" IsVisible="{Binding HasMap}">
                    <TextBlock Text="{Binding MapLine}" FontSize="10" Foreground="{DynamicResource TextMid}" />
                    <ItemsControl ItemsSource="{Binding Aliases}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CalloutAliasRow">
                                <Grid ColumnDefinitions="80,*,Auto,Auto" ColumnSpacing="4" Margin="0 0 0 3">
                                    <TextBox Grid.Column="0" FontSize="11" Watermark="alias"
                                             Text="{Binding Alias, UpdateSourceTrigger=LostFocus}" />
                                    <TextBox Grid.Column="1" FontSize="11" Watermark="place or callout"
                                             Text="{Binding Place, UpdateSourceTrigger=LostFocus}" />
                                    <CheckBox Grid.Column="2" Content="primary" FontSize="10"
                                              IsChecked="{Binding Primary}"
                                              ToolTip.Tip="The word the UI shows for this place" />
                                    <Button Grid.Column="3" Content="✕" Classes="ghost" FontSize="10" Padding="6 2"
                                            Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this alias" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="4">
                        <TextBox Grid.Column="0" FontSize="11" Watermark="new alias" Text="{Binding NewAliasText}" />
                        <TextBox Grid.Column="1" FontSize="11" Watermark="place or callout" Text="{Binding NewPlaceText}" />
                        <Button Grid.Column="2" Content="Add" Classes="ghost" FontSize="11" Padding="8 3"
                                Command="{Binding AddAliasCommand}" />
                    </Grid>
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock Text="copy from" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMid}" Margin="0 0 6 4" />
                        <ComboBox ItemsSource="{Binding CopySources}" SelectedItem="{Binding CopyFrom}"
                                  FontSize="11" MinWidth="120" Margin="0 0 6 4">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:StratOwnerOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Copy aliases" Classes="ghost" FontSize="11" Padding="8 3" Margin="0 0 0 4"
                                Command="{Binding CopyAliasesCommand}"
                                ToolTip.Tip="Replaces this book's aliases on this map with theirs" />
                    </WrapPanel>
                    <TextBlock Text="{Binding IssueLine}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMid}" IsVisible="{Binding HasIssue}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="16">

        <!-- The book, the filters, and the browser note. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1" CornerRadius="6" Padding="12 10" Margin="0 0 0 12">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Static vm:StratBookTabViewModel.BrowserNote}" FontSize="11"
                           Foreground="{DynamicResource TextMid}" IsVisible="{Binding IsBrowser}" />
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Book" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextValue}" Margin="0 0 8 4" />
                    <ComboBox ItemsSource="{Binding Owners}" SelectedItem="{Binding SelectedOwner}"
                              FontSize="12" MinWidth="180" Margin="0 0 16 4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:StratOwnerOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Map" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextValue}" Margin="0 0 8 4" />
                    <ComboBox ItemsSource="{Binding MapOptions}" SelectedItem="{Binding SelectedMap}"
                              FontSize="12" MinWidth="130" Margin="0 0 16 4" />
                    <TextBlock Text="Side" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextValue}" Margin="0 0 8 4" />
                    <ComboBox ItemsSource="{x:Static vm:StratBookTabViewModel.SideOptions}" SelectedItem="{Binding SelectedSide}"
                              FontSize="12" MinWidth="100" Margin="0 0 16 4" />
                    <!-- The button makes a blank strat. The menu (Blank, then the templates) is built in code
                         from StratTemplates. -->
                    <SplitButton x:Name="NewStratButton" Content="New strat" Classes="ghost" FontSize="11" Padding="10 5" Margin="0 0 8 4"
                                 Command="{Binding NewStratCommand}"
                                 ToolTip.Tip="A new strat in this book on the chosen map and side; the arrow starts it from a template">
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft" />
                        </SplitButton.Flyout>
                    </SplitButton>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="Auto,12,*,6,1.3*">

            <!-- The strat list, and below it the book's callout aliases for the selected map. « collapses
                 both to the strip below; the choice is kept in the session file. -->
            <Grid Grid.Column="0" Width="280" RowDefinitions="*,12,Auto" IsVisible="{Binding !Layout.IsListCollapsed}">
                <Border Grid.Row="0"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="6" Padding="12 10">
                    <DockPanel>
                        <!-- Book or Detected (Strat Mining): the book's strats, or the repeated setups and
                             executes found in the library that are not in a book yet. -->
                        <DockPanel DockPanel.Dock="Top" Margin="0 0 0 8">
                        <Button x:Name="CollapseList" DockPanel.Dock="Right" Classes="pane-toggle" Content="«"
                                Command="{Binding Layout.ToggleListCommand}"
                                ToolTip.Tip="Collapse the strat list; a header keeps the picker and the callouts" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <ToggleButton x:Name="BookToggle" Content="Book" FontSize="11" Padding="10 4"
                                          IsChecked="{Binding !IsDetectedView, Mode=OneWay}" Command="{Binding ShowBookCommand}" />
                            <ToggleButton x:Name="DetectedToggle" Content="{Binding DetectedHeader}" FontSize="11" Padding="10 4"
                                          IsChecked="{Binding IsDetectedView, Mode=OneWay}" Command="{Binding ShowDetectedCommand}"
                                          ToolTip.Tip="Setups and executes seen at least twice in the library" />
                        </StackPanel>
                        </DockPanel>
                        <Panel DockPanel.Dock="Bottom" IsVisible="{Binding IsDetectedView}">
                            <StackPanel Spacing="6" Margin="0 8 0 0"
                                        DataContext="{Binding Detected}" x:DataType="vm:DetectedStratsViewModel">
                                <TextBlock Text="{Binding StateProblem}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMid}" IsVisible="{Binding HasStateProblem}" />
                                <TextBlock Text="{Binding StatusLine}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMid}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Find strats" Classes="ghost" FontSize="11" Padding="10 5"
                                            Command="{Binding FindCommand}" IsEnabled="{Binding !IsMining}"
                                            ToolTip.Tip="Search every indexed demo for repeated setups and executes" />
                                    <CheckBox Content="{Binding SettledLabel}" FontSize="11" IsChecked="{Binding ShowSettled}"
                                              ToolTip.Tip="Also list the patterns you dismissed or added to a book" />
                                </StackPanel>
                            </StackPanel>
                        </Panel>
                        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0 8 0 0" IsVisible="{Binding !IsDetectedView}">
                            <TextBlock Text="{Binding ListLine}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMid}" />
                            <Button Content="Delete" Classes="ghost" FontSize="11" Padding="10 5"
                                    Command="{Binding DeleteStratCommand}"
                                    ToolTip.Tip="Moves the strat and its history to the book's .trash folder" />
                        </StackPanel>
                        <Panel>
                            <ListBox ItemsSource="{Binding Strats}" SelectedItem="{Binding SelectedStrat}"
                                     IsVisible="{Binding ShowBookList}" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StratListRow">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextValue}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Summary}" FontSize="10" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextMid}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Panel IsVisible="{Binding IsDetectedView}">
                                <ListBox x:Name="DetectedList" Background="Transparent"
                                         DataContext="{Binding Detected}" x:DataType="vm:DetectedStratsViewModel"
                                         ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DetectedRowViewModel">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource TextValue}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Summary}" FontSize="10" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextMid}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Panel>
                        </Panel>
                    </DockPanel>
                </Border>

                <!-- Callout Aliases (strat-model.md §3.7): the book's words over this map's places. -->
                <Border Grid.Row="2"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1" CornerRadius="6" Padding="12 10">
                    <ContentControl Content="{Binding Callouts}" ContentTemplate="{StaticResource CalloutsEditorTemplate}" />
                </Border>
            </Grid>

            <!-- The collapsed list: » brings it back. The header over column 2 carries the picker meanwhile. -->
            <Border Grid.Column="0" Width="32" IsVisible="{Binding Layout.IsListCollapsed}"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="6" Padding="0 6">
                <DockPanel>
                    <Button x:Name="ExpandList" DockPanel.Dock="Top" Classes="pane-toggle" Content="»"
                            HorizontalAlignment="Center" Margin="0 0 0 8"
                            Command="{Binding Layout.ToggleListCommand}"
                            ToolTip.Tip="Show the strat list" />
                    <LayoutTransformControl VerticalAlignment="Top" HorizontalAlignment="Center">
                        <LayoutTransformControl.LayoutTransform>
                            <RotateTransform Angle="90" />
                        </LayoutTransformControl.LayoutTransform>
                        <TextBlock Text="{Binding CollapsedListLabel}" Classes="col-label" FontSize="11"
                                   Foreground="{DynamicResource TextCardHeader}" />
                    </LayoutTransformControl>
                </DockPanel>
            </Border>

            <!-- A detected pattern (Strat Mining): what it is, where it was seen, and Add to book. -->
            <!-- Column 2: while the list is collapsed, a header with what the list was the way to reach (Book or
                 Detected, the strat or pattern, the callouts); then the detected pattern or the editor. -->
            <DockPanel Grid.Column="2">
            <Border x:Name="StratPicker" DockPanel.Dock="Top" IsVisible="{Binding Layout.IsListCollapsed}"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="6" Padding="12 8" Margin="0 0 0 8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                        <ToggleButton Content="Book" FontSize="11" Padding="10 4"
                                      IsChecked="{Binding !IsDetectedView, Mode=OneWay}" Command="{Binding ShowBookCommand}" />
                        <ToggleButton Content="{Binding DetectedHeader}" FontSize="11" Padding="10 4"
                                      IsChecked="{Binding IsDetectedView, Mode=OneWay}" Command="{Binding ShowDetectedCommand}"
                                      ToolTip.Tip="Setups and executes seen at least twice in the library" />
                    </StackPanel>
                    <Panel Grid.Column="1">
                        <ComboBox x:Name="StratPickerCombo" FontSize="12" HorizontalAlignment="Stretch" MinWidth="0"
                                  IsVisible="{Binding !IsDetectedView}"
                                  ItemsSource="{Binding Strats}" SelectedItem="{Binding SelectedStrat}"
                                  PlaceholderText="pick a strat"
                                  ToolTip.Tip="The strats in this book on the chosen map and side">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:StratListRow">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Panel IsVisible="{Binding IsDetectedView}">
                        <ComboBox x:Name="DetectedPickerCombo" FontSize="12" HorizontalAlignment="Stretch" MinWidth="0"
                                  DataContext="{Binding Detected}" x:DataType="vm:DetectedStratsViewModel"
                                  ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                                  PlaceholderText="pick a detected pattern">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DetectedRowViewModel">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        </Panel>
                    </Panel>
                    <Button x:Name="CalloutsButton" Grid.Column="2" Content="Callouts" Classes="ghost" FontSize="11" Padding="10 5"
                            ToolTip.Tip="The book's callout aliases for this map">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <ContentControl Width="340" Content="{Binding Callouts}"
                                                ContentTemplate="{StaticResource CalloutsEditorTemplate}" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>
            <Panel>
            <Border x:Name="DetectedDetail" IsVisible="{Binding IsDetectedView}"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="6" Padding="12 10">
                <Panel DataContext="{Binding Detected}" x:DataType="vm:DetectedStratsViewModel">
                    <TextBlock Text="select a detected pattern" FontSize="11" Foreground="{DynamicResource TextMid}"
                               IsVisible="{Binding !HasSelection}" />
                    <ScrollViewer IsVisible="{Binding ShowPatternDetail}">
                        <StackPanel Spacing="10" DataContext="{Binding SelectedRow}" x:DataType="vm:DetectedRowViewModel">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextValue}" />
                            <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMid}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="DetectedPreviewButton" Content="Preview" Classes="ghost" FontSize="11" Padding="10 5" IsVisible="{Binding CanAdd}"
                                        Command="{Binding $parent[UserControl].((vm:StratBookTabViewModel)DataContext).Detected.PreviewStratCommand}"
                                        ToolTip.Tip="See the strat this pattern would become, playing, before adding it. Nothing is saved." />
                                <Button Content="Add to book" Classes="ghost" FontSize="11" Padding="10 5" IsVisible="{Binding CanAdd}"
                                        Command="{Binding $parent[UserControl].((vm:StratBookTabViewModel)DataContext).Detected.AddToBookCommand}"
                                        ToolTip.Tip="Build a strat from the most typical round into the book selected above, with every round as a run" />
                                <Button Content="Open strat" Classes="ghost" FontSize="11" Padding="10 5" IsVisible="{Binding IsInBook}"
                                        Command="{Binding $parent[UserControl].((vm:StratBookTabViewModel)DataContext).Detected.OpenStratCommand}" />
                                <Button Content="Dismiss" Classes="ghost" FontSize="11" Padding="10 5" IsVisible="{Binding !IsDismissed}"
                                        Command="{Binding $parent[UserControl].((vm:StratBookTabViewModel)DataContext).Detected.DismissCommand}"
                                        ToolTip.Tip="Hide this pattern; it stays hidden when strats are found again" />
                                <Button Content="Restore" Classes="ghost" FontSize="11" Padding="10 5" IsVisible="{Binding IsDismissed}"
                                        Command="{Binding $parent[UserControl].((vm:StratBookTabViewModel)DataContext).Detected.RestoreCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding TeamsLine}" FontSize="12" Foreground="{DynamicResource TextValue}" />
                            <TextBlock Text="{Binding TimingLine}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextValue}" />
                            <TextBlock Text="{Binding UtilityLine}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMid}" />
                            <TextBlock Text="Utility most rounds share" Classes="col-label" FontSize="11"
                                       Foreground="{DynamicResource TextCardHeader}" IsVisible="{Binding HasCommonThrows}" />
                            <ItemsControl ItemsSource="{Binding CommonThrows}" IsVisible="{Binding HasCommonThrows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0 0 0 2"
                                                   Foreground="{DynamicResource TextValue}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Rounds" Classes="col-label" FontSize="11" Foreground="{DynamicResource TextCardHeader}" />
                            <ItemsControl ItemsSource="{Binding Members}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DetectedMemberRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0 0 0 3">
                                            <TextBlock Grid.Column="0" Text="{Binding Line}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextValue}" />
                                            <Button Grid.Column="1" Content="Open" Classes="ghost" FontSize="10" Padding="8 2"
                                                    Command="{Binding $parent[UserControl].((vm:StratBookTabViewModel)DataContext).Detected.OpenRoundCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Open this round in 2D Playback" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- The preview: the strat Add to book would save, as text, never as fields. The canvas on
                         the right plays it. -->
                    <ScrollViewer x:Name="DetectedPreview" IsVisible="{Binding IsPreviewing}">
                        <StackPanel Spacing="10" DataContext="{Binding Preview}" x:DataType="vm:StratPreviewViewModel">
                            <TextBlock Text="Preview · not in the book" Classes="col-label" FontSize="11"
                                       Foreground="{DynamicResource TextCardHeader}" />
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextValue}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Add to book" Classes="ghost" FontSize="11" Padding="10 5" IsEnabled="{Binding IsReady}"
                                        Command="{Binding $parent[UserControl].((vm:StratBookTabViewModel)DataContext).Detected.AddToBookCommand}"
                                        ToolTip.Tip="Save this strat into the book selected above, with every round as a run" />
                                <Button Content="Dismiss" Classes="ghost" FontSize="11" Padding="10 5"
                                        Command="{Binding $parent[UserControl].((vm:StratBookTabViewModel)DataContext).Detected.DismissCommand}"
                                        ToolTip.Tip="Hide this pattern; it stays hidden when strats are found again" />
                                <Button Content="Back to detected" Classes="ghost" FontSize="11" Padding="10 5"
                                        Command="{Binding $parent[UserControl].((vm:StratBookTabViewModel)DataContext).Detected.BackToDetectedCommand}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Notice}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextValue}" IsVisible="{Binding HasNotice}" />
                            <TextBlock Text="Building the strat from the most typical round's cached files…" FontSize="11"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextMid}" IsVisible="{Binding IsLoading}" />
                            <TextBlock Text="{x:Static vm:StratPreviewViewModel.MissingLine}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextValue}" IsVisible="{Binding IsMissing}" />
                            <StackPanel Spacing="10" IsVisible="{Binding IsReady}">
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StratPreviewField">
                                            <Grid ColumnDefinitions="80,*" ColumnSpacing="8" Margin="0 0 0 2">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource TextMid}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextValue}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Notes}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMid}"
                                           IsVisible="{Binding HasNotes}" />
                                <TextBlock Text="Slots" Classes="col-label" FontSize="11" Foreground="{DynamicResource TextCardHeader}" />
                                <ItemsControl ItemsSource="{Binding Slots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StratPreviewField">
                                            <Grid ColumnDefinitions="80,*" ColumnSpacing="8" Margin="0 0 0 2">
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource TextMid}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextValue}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Steps (round clock remaining)" Classes="col-label" FontSize="11"
                                           Foreground="{DynamicResource TextCardHeader}" />
                                <ItemsControl x:Name="DetectedPreviewSteps" ItemsSource="{Binding Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StratPreviewStepRow">
                                            <Grid ColumnDefinitions="32,22,48,*" ColumnSpacing="6" Margin="0 0 0 3">
                                                <TextBlock Grid.Column="0" Text="{Binding Marker}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextValue}" />
                                                <TextBlock Grid.Column="1" Text="{Binding NumberText}" FontSize="11" Foreground="{DynamicResource TextMid}" />
                                                <TextBlock Grid.Column="2" Text="{Binding AtText}" FontSize="11" Foreground="{DynamicResource TextMid}" />
                                                <StackPanel Grid.Column="3" Spacing="1">
                                                    <TextBlock Classes="previewStep" Classes.previewStepActive="{Binding IsActive}"
                                                               Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Note}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextMid}" IsVisible="{Binding HasNote}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock Text="Rounds" Classes="col-label" FontSize="11" Foreground="{DynamicResource TextCardHeader}" />
                            <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:StratBookTabViewModel)DataContext).Detected.SelectedRow.Members}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DetectedMemberRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0 0 0 3">
                                            <TextBlock Grid.Column="0" Text="{Binding Line}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextValue}" />
                                            <Button Grid.Column="1" Content="Open" Classes="ghost" FontSize="10" Padding="8 2"
                                                    Command="{Binding $parent[UserControl].((vm:StratBookTabViewModel)DataContext).Detected.OpenRoundCommand}"
                                                    CommandParameter="{Binding}" ToolTip.Tip="Open this round in 2D Playback" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Panel>
            </Border>

            <!-- The editor. -->
            <Border IsVisible="{Binding !IsDetectedView}"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="6" Padding="12 10">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0 0 0 8">
                        <TextBlock Grid.Column="0" Text="{Binding StatusLine}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMid}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasOpenStrat}">
                            <Button Content="Undo" Classes="ghost" FontSize="11" Padding="10 5"
                                    Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Ctrl+Z" />
                            <Button Content="Redo" Classes="ghost" FontSize="11" Padding="10 5"
                                    Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Ctrl+Shift+Z" />
                            <Button Content="Save" Classes="ghost" FontSize="11" Padding="10 5"
                                    Command="{Binding SaveCommand}" IsEnabled="{Binding HasPending}"
                                    ToolTip.Tip="Commit the edits as one history entry" />
                        </StackPanel>
                    </Grid>

                    <!-- Its own row: in the header it squeezed the status line to a letter per line at 1280. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0 0 0 8"
                                IsVisible="{Binding CanApplyTemplate}">
                        <TextBlock Text="no steps yet" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMid}" />
                        <DropDownButton x:Name="ApplyTemplateButton" Content="Apply template" Classes="ghost" FontSize="11" Padding="10 5"
                                        ToolTip.Tip="Fill this strat from a template; only while it has no steps beyond the spawns">
                            <DropDownButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnApplyTemplateMenuOpening" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top" Text="select or create a strat" FontSize="11"
                               Foreground="{DynamicResource TextMid}" IsVisible="{Binding !HasOpenStrat}" />

                    <ScrollViewer x:Name="EditorScroll" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasDocument}"
                                  DataContext="{Binding Editor}" x:DataType="vm:StratEditorViewModel">
                        <!-- The right margin keeps fields clear of the overlay scrollbar. -->
                        <StackPanel Spacing="10" Margin="0 0 12 0">

                            <!-- Metadata: name, the map and clock as one line, then the vocabulary fields as
                                 label-over-field pairs that wrap to the editor's width. -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Name" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextValue}" />
                                <TextBox Grid.Column="1" FontSize="12" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                            </Grid>
                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMid}">
                                <Run Text="{Binding Map}" /><Run Text=" · " /><Run Text="{Binding ClockLine}" />
                            </TextBlock>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                <StackPanel Classes="stratField" Width="132">
                                    <TextBlock Text="side" Classes="stratFieldLabel" />
                                    <ComboBox ItemsSource="{x:Static vm:StratEditorViewModel.Sides}" SelectedItem="{Binding Side}" />
                                </StackPanel>
                                <StackPanel Classes="stratField" Width="132">
                                    <TextBlock Text="type" Classes="stratFieldLabel" />
                                    <ComboBox ItemsSource="{x:Static vm:StratEditorViewModel.Types}" SelectedItem="{Binding Type}" />
                                </StackPanel>
                                <StackPanel Classes="stratField" Width="132">
                                    <TextBlock Text="target site" Classes="stratFieldLabel" />
                                    <ComboBox ItemsSource="{x:Static vm:StratEditorViewModel.TargetSites}" SelectedItem="{Binding TargetSite}" />
                                </StackPanel>
                                <StackPanel Classes="stratField" Width="132">
                                    <TextBlock Text="status" Classes="stratFieldLabel" />
                                    <ComboBox ItemsSource="{x:Static vm:StratEditorViewModel.Statuses}" SelectedItem="{Binding Status}" />
                                </StackPanel>
                                <StackPanel Classes="stratField" Width="132">
                                    <TextBlock Text="economy" Classes="stratFieldLabel" />
                                    <ComboBox ItemsSource="{x:Static vm:StratEditorViewModel.Economies}" SelectedItem="{Binding Economy}" />
                                </StackPanel>
                                <StackPanel Classes="stratField" Width="132">
                                    <TextBlock Text="tempo" Classes="stratFieldLabel" />
                                    <ComboBox ItemsSource="{x:Static vm:StratEditorViewModel.Tempos}" SelectedItem="{Binding Tempo}" />
                                </StackPanel>
                            </WrapPanel>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Trigger" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextValue}" />
                                <TextBox Grid.Row="0" Grid.Column="1" FontSize="12" Watermark="on call at 1:15"
                                         Text="{Binding TriggerText, UpdateSourceTrigger=LostFocus}" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tags" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextValue}" />
                                <TextBox Grid.Row="1" Grid.Column="1" FontSize="12" Watermark="comma separated"
                                         Text="{Binding TagsText, UpdateSourceTrigger=LostFocus}" />
                            </Grid>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=LostFocus}" FontSize="12" Watermark="notes"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" />

                            <!-- Slots. -->
                            <TextBlock Text="Slots" Classes="col-label" Foreground="{DynamicResource TextCardHeader}" FontSize="11" />
                            <ItemsControl ItemsSource="{Binding Slots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StratSlotRow">
                                        <Grid ColumnDefinitions="44,*,Auto,*" ColumnSpacing="6" Margin="0 0 0 4">
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextValue}" />
                                            <TextBox Grid.Column="1" FontSize="12" Watermark="role" MinWidth="0"
                                                     Text="{Binding Role, UpdateSourceTrigger=LostFocus}" />
                                            <TextBlock Grid.Column="2" Text="pin" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMid}" />
                                            <ComboBox Grid.Column="3" FontSize="12" MinWidth="0" HorizontalAlignment="Stretch"
                                                      ToolTip.Tip="Who plays this slot; the book default when unpinned"
                                                      ItemsSource="{Binding $parent[ItemsControl].((vm:StratEditorViewModel)DataContext).PinOptions}"
                                                      SelectedItem="{Binding Pin}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:StratPinOption">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Steps. -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Steps (round clock remaining, m:ss; +m:ss after the timer stopped)" Classes="col-label" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextCardHeader}" FontSize="11" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Add step" Classes="ghost" FontSize="11" Padding="10 5"
                                        Command="{Binding AddStepCommand}" />
                            </Grid>
                            <!-- One step: number, time, actor and verb on the first line with the row's
                                 buttons, then only the fields the verb uses (StratStepFields; a field holding a
                                 value shows whatever the verb), wrapping to the editor's width. -->
                            <Grid ColumnDefinitions="20,56,64,84,*" ColumnSpacing="4">
                                <TextBlock Grid.Column="0" Text="#" Classes="stratFieldLabel" />
                                <TextBlock Grid.Column="1" Text="at" Classes="stratFieldLabel" />
                                <TextBlock Grid.Column="2" Text="actor" Classes="stratFieldLabel" />
                                <TextBlock Grid.Column="3" Text="verb" Classes="stratFieldLabel" />
                            </Grid>
                            <ItemsControl x:Name="StepRows" ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StratStepRow">
                                        <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 0 1"
                                                Padding="0 0 0 6" Margin="0 0 0 6">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="20,56,64,84,*,Auto" ColumnSpacing="4">
                                                    <TextBlock Grid.Column="0" Text="{Binding Number}" FontSize="12" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextMid}" />
                                                    <TextBox Grid.Column="1" FontSize="12" MinWidth="0"
                                                             Text="{Binding TimeText, UpdateSourceTrigger=LostFocus}" />
                                                    <ComboBox Grid.Column="2" FontSize="12" MinWidth="0" HorizontalAlignment="Stretch"
                                                              ItemsSource="{x:Static vm:StratEditorViewModel.Actors}" SelectedItem="{Binding Actor}" />
                                                    <ComboBox Grid.Column="3" FontSize="12" MinWidth="0" HorizontalAlignment="Stretch"
                                                              ItemsSource="{x:Static vm:StratEditorViewModel.Verbs}" SelectedItem="{Binding Verb}"
                                                              ToolTip.Tip="Changing the verb clears the fields the new verb does not use" />
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2">
                                                        <Button Content="↑" Classes="icon-btn" ToolTip.Tip="Move up"
                                                                Command="{Binding $parent[ItemsControl].((vm:StratEditorViewModel)DataContext).MoveStepUpCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="↓" Classes="icon-btn" ToolTip.Tip="Move down"
                                                                Command="{Binding $parent[ItemsControl].((vm:StratEditorViewModel)DataContext).MoveStepDownCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="✕" Classes="icon-btn"
                                                                ToolTip.Tip="Remove the step and every branch that names it"
                                                                Command="{Binding $parent[ItemsControl].((vm:StratEditorViewModel)DataContext).RemoveStepCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" Margin="24 0 0 0">
                                                    <StackPanel Classes="stratField" IsVisible="{Binding ShowFrom}">
                                                        <TextBlock Text="from" Classes="stratFieldLabel" />
                                                        <TextBox Width="128" Watermark="place or callout"
                                                                 Text="{Binding FromText, UpdateSourceTrigger=LostFocus}" />
                                                    </StackPanel>
                                                    <StackPanel Classes="stratField" IsVisible="{Binding ShowTo}">
                                                        <TextBlock Text="{Binding ToLabel}" Classes="stratFieldLabel" />
                                                        <TextBox Width="128" Watermark="place or callout"
                                                                 Text="{Binding ToText, UpdateSourceTrigger=LostFocus}" />
                                                    </StackPanel>
                                                    <StackPanel Classes="stratField" IsVisible="{Binding ShowUtility}">
                                                        <TextBlock Text="utility" Classes="stratFieldLabel" />
                                                        <ComboBox Width="96" ItemsSource="{x:Static vm:StratEditorViewModel.UtilityKinds}"
                                                                  SelectedItem="{Binding UtilityKind}" />
                                                    </StackPanel>
                                                    <!-- The visual lineup picker's button goes beside this combo. -->
                                                    <StackPanel Classes="stratField" IsVisible="{Binding ShowLineup}">
                                                        <TextBlock Text="lineup" Classes="stratFieldLabel"
                                                                   ToolTip.Tip="A Utility Book lineup this throw is (Lineup On A Strat Step)" />
                                                        <ComboBox Width="160" ItemsSource="{Binding LineupOptions}" SelectedItem="{Binding Lineup}"
                                                                  ToolTip.Tip="A Utility Book lineup this throw is (Lineup On A Strat Step)" />
                                                    </StackPanel>
                                                    <StackPanel Classes="stratField" IsVisible="{Binding ShowLanding}">
                                                        <TextBlock Text="lands at" Classes="stratFieldLabel" />
                                                        <TextBox Width="128" Watermark="landing place"
                                                                 Text="{Binding LandingText, UpdateSourceTrigger=LostFocus}" />
                                                    </StackPanel>
                                                    <StackPanel Classes="stratField">
                                                        <TextBlock Text="note" Classes="stratFieldLabel" />
                                                        <TextBox Width="200" Watermark="note"
                                                                 Text="{Binding Note, UpdateSourceTrigger=LostFocus}" />
                                                    </StackPanel>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Branches. -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="Branches" Classes="col-label"
                                           Foreground="{DynamicResource TextCardHeader}" FontSize="11" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Add branch" Classes="ghost" FontSize="11" Padding="10 5"
                                        Command="{Binding AddBranchCommand}"
                                        ToolTip.Tip="After a step, if a condition holds, continue in this strat or another" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Branches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StratBranchRow">
                                        <WrapPanel Orientation="Horizontal" Margin="0 0 0 6">
                                            <TextBlock Text="after" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextMid}" Margin="0 0 6 4" />
                                            <ComboBox FontSize="12" MinWidth="150" Margin="0 0 8 4"
                                                      ItemsSource="{Binding $parent[ItemsControl].((vm:StratEditorViewModel)DataContext).StepOptions}"
                                                      SelectedItem="{Binding AfterStep}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:StratStepOption">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="if" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextMid}" Margin="0 0 6 4" />
                                            <TextBox FontSize="12" MinWidth="200" Margin="0 0 8 4" Watermark="contact at Connector before 1:05"
                                                     Text="{Binding ConditionText, UpdateSourceTrigger=LostFocus}" />
                                            <TextBlock Text="continue in" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextMid}" Margin="0 0 6 4" />
                                            <ComboBox FontSize="12" MinWidth="150" Margin="0 0 8 4"
                                                      ItemsSource="{Binding $parent[ItemsControl].((vm:StratEditorViewModel)DataContext).TargetStrats}"
                                                      SelectedItem="{Binding TargetStrat}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:StratTargetOption">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBlock Text="at" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextMid}" Margin="0 0 6 4" />
                                            <ComboBox FontSize="12" MinWidth="150" Margin="0 0 8 4"
                                                      ItemsSource="{Binding TargetStepOptions}" SelectedItem="{Binding TargetStep}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:StratStepOption">
                                                        <TextBlock Text="{Binding Label}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <TextBox FontSize="12" MinWidth="140" Margin="0 0 8 4" Watermark="note"
                                                     Text="{Binding Note, UpdateSourceTrigger=LostFocus}" />
                                            <Button Content="Remove" Classes="ghost" FontSize="11" Padding="8 3" Margin="0 0 0 4"
                                                    Command="{Binding $parent[ItemsControl].((vm:StratEditorViewModel)DataContext).RemoveBranchCommand}"
                                                    CommandParameter="{Binding}" />
                                        </WrapPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- What the validator says. -->
                            <StackPanel Spacing="2" IsVisible="{Binding HasIssues}">
                                <TextBlock Text="Checks" Classes="col-label" Foreground="{DynamicResource TextCardHeader}" FontSize="11" />
                                <ItemsControl ItemsSource="{Binding Issues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMid}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- The Strat Record Panel (strat-model.md §3.6): run/won/lost/aborted, split by Demo
                                 Provenance Labels, the small-sample caution, the failure breakdown; every number
                                 sends its runs to the Review Queue. Reads the tab's RecordPanel, not the editor. -->
                            <StackPanel Spacing="6"
                                        DataContext="{Binding $parent[UserControl].((vm:StratBookTabViewModel)DataContext).RecordPanel}"
                                        x:DataType="vm:StratRecordPanelViewModel">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="Record" Classes="col-label"
                                               Foreground="{DynamicResource TextCardHeader}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="computing…" FontSize="11"
                                               Foreground="{DynamicResource TextMid}" IsVisible="{Binding IsComputing}" />
                                </Grid>
                                <TextBlock Text="{Binding Caution}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMid}" IsVisible="{Binding HasCaution}" />
                                <TextBlock Text="{Binding UnknownNote}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMid}" IsVisible="{Binding HasUnknownNote}" />
                                <ContentControl Content="{Binding Total}" ContentTemplate="{StaticResource RecordSplitRowTemplate}" />
                                <TextBlock Text="by provenance" FontSize="10" Foreground="{DynamicResource TextMid}"
                                           IsVisible="{Binding HasProvenanceRows}" />
                                <ItemsControl ItemsSource="{Binding ByProvenance}" ItemTemplate="{StaticResource RecordSplitRowTemplate}" />
                                <TextBlock Text="Failures (lost or aborted runs only)" Classes="col-label"
                                           Foreground="{DynamicResource TextCardHeader}" FontSize="11" IsVisible="{Binding HasFailures}" />
                                <ItemsControl ItemsSource="{Binding Failures}" IsVisible="{Binding HasFailures}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StratRecordFailureRow">
                                            <Grid ColumnDefinitions="140,56" ColumnSpacing="4" Margin="0 0 0 3">
                                                <TextBlock Grid.Column="0" Text="{Binding Failure}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextValue}" />
                                                <Button Grid.Column="1" Classes="ghost" FontSize="11" Padding="6 2"
                                                        Content="{Binding Clips.CountText}" Command="{Binding Clips.OpenCommand}"
                                                        ToolTip.Tip="{Binding Clips.Tip}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding StatusLine}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMid}"
                                           IsVisible="{Binding StatusLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>

                            <!-- Role View And LAN Print (strat-model.md §3.14): one slot's parts on
                                 screen, picked here, and a button that prints all five as one HTML page
                                 opened in the system browser. Reads the tab's RoleView, not the editor. -->
                            <StackPanel Spacing="6"
                                        DataContext="{Binding $parent[UserControl].((vm:StratBookTabViewModel)DataContext).RoleView}"
                                        x:DataType="vm:StratRoleViewPanelViewModel">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="Role View" Classes="col-label"
                                               Foreground="{DynamicResource TextCardHeader}" FontSize="11" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:StratRoleViewPanelViewModel.Slots}"
                                              SelectedItem="{Binding SelectedSlot}" FontSize="11" IsVisible="{Binding HasStrat}" />
                                    <Button Grid.Column="3" Content="Print role sheets" Classes="ghost" FontSize="11" Padding="8 3"
                                            Command="{Binding PrintCommand}" IsVisible="{Binding !IsBrowser}"
                                            ToolTip.Tip="Writes one HTML page per slot and opens it in the system browser" />
                                </Grid>
                                <TextBlock Text="open a strat to see its role sheets" FontSize="11"
                                           Foreground="{DynamicResource TextMid}" IsVisible="{Binding !HasStrat}" />
                                <StackPanel Spacing="4" IsVisible="{Binding HasStrat}">
                                    <TextBlock Text="{Binding SlotLine}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextValue}" />
                                    <TextBlock Text="{Binding MetaLine}" FontSize="11" Foreground="{DynamicResource TextMid}" />
                                    <TextBlock Text="{Binding TriggerLine}" FontSize="11" Foreground="{DynamicResource TextMid}" IsVisible="{Binding HasTriggerLine}" />
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:RoleViewLineRow">
                                                <TextBlock Classes="roleLine" Classes.roleLineContext="{Binding IsContext}"
                                                           FontSize="11" TextWrapping="Wrap" Margin="0 2 0 0">
                                                    <Run Text="{Binding AtText}" /><Run Text=" · " /><Run Text="{Binding Text}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Branches}" IsVisible="{Binding HasBranches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextMid}" Margin="8 2 0 0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding StatusFooter}" FontSize="10" Foreground="{DynamicResource TextMid}" />
                                </StackPanel>
                                <TextBlock Text="{Binding PrintUnavailableNote}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMid}" IsVisible="{Binding HasPrintUnavailableNote}" />
                                <TextBlock Text="{Binding StatusLine}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMid}"
                                           IsVisible="{Binding StatusLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>

                            <!-- Strat Version History (strat-model.md §3.8): the append-only diff log,
                                 newest entry first, each phrased against the document as it stood just
                                 before it, with the record split either side of the entry's revision.
                                 Reads the tab's HistoryPanel, not the editor. -->
                            <StackPanel Spacing="6"
                                        DataContext="{Binding $parent[UserControl].((vm:StratBookTabViewModel)DataContext).HistoryPanel}"
                                        x:DataType="vm:StratHistoryPanelViewModel">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="History" Classes="col-label"
                                               Foreground="{DynamicResource TextCardHeader}" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="computing…" FontSize="11"
                                               Foreground="{DynamicResource TextMid}" IsVisible="{Binding IsComputing}" />
                                </Grid>
                                <TextBlock Text="no history yet" FontSize="11" Foreground="{DynamicResource TextMid}"
                                           IsVisible="{Binding !HasEntries}" />
                                <ItemsControl ItemsSource="{Binding Entries}" IsVisible="{Binding HasEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StratHistoryEntryRow">
                                            <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0 0 0 1"
                                                    Padding="0 0 0 6" Margin="0 0 0 6">
                                                <StackPanel Spacing="2">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="{Binding RevisionText}" FontSize="11"
                                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextValue}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding WhenText}" FontSize="10"
                                                                   HorizontalAlignment="Right" Foreground="{DynamicResource TextMid}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource TextValue}" />
                                                    <ItemsControl ItemsSource="{Binding Changes}" IsVisible="{Binding ShowChangeList}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <TextBlock Text="{Binding}" FontSize="10" TextWrapping="Wrap"
                                                                           Foreground="{DynamicResource TextMid}" Margin="8 0 0 0" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Grid ColumnDefinitions="44,*" ColumnSpacing="6" IsVisible="{Binding HasSplit}">
                                                        <TextBlock Grid.Column="0" Text="before" FontSize="10" Foreground="{DynamicResource TextMid}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding BeforeText}" FontSize="10" Foreground="{DynamicResource TextMid}" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="44,*" ColumnSpacing="6" IsVisible="{Binding HasSplit}">
                                                        <TextBlock Grid.Column="0" Text="after" FontSize="10" Foreground="{DynamicResource TextMid}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding AfterText}" FontSize="10" Foreground="{DynamicResource TextMid}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding StatusLine}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMid}"
                                           IsVisible="{Binding StatusLine, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            </Panel>
            </DockPanel>

            <GridSplitter Grid.Column="3" Background="Transparent" Width="6" />

            <!-- The Step Authoring canvas (step-authoring.md §3.10), beside the step table it plays. -->
            <Border Grid.Column="4"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1" CornerRadius="6" Padding="12 10">
                <Panel>
                    <!-- The Detected preview's canvas: plays the unsaved strat, no tools. -->
                    <DockPanel x:Name="DetectedPreviewCanvas" IsVisible="{Binding Detected.IsPreviewing}">
                        <TextBlock DockPanel.Dock="Top" Text="Preview: plays the strat as it would be saved. Nothing here is in the book yet."
                                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMid}" Margin="0 0 0 6" />
                        <Panel>
                            <TextBlock Text="building…" FontSize="11" Foreground="{DynamicResource TextMid}"
                                       IsVisible="{Binding Detected.Preview.IsLoading, FallbackValue=False}" />
                            <TextBlock Text="nothing to play" FontSize="11" Foreground="{DynamicResource TextMid}"
                                       IsVisible="{Binding Detected.Preview.IsMissing, FallbackValue=False}" />
                            <sb:StratCanvasView DataContext="{Binding Detected.Preview.Canvas}" x:DataType="canvas:StratCanvasViewModel"
                                                IsVisible="{Binding HasDocument, FallbackValue=False}" />
                        </Panel>
                    </DockPanel>
                    <DockPanel IsVisible="{Binding !Detected.IsPreviewing}">
                        <!-- Strat Export (step-authoring.md §3.6). The button when this build can export; on the
                             browser the same slot says why it cannot, the 2D tab's wording. -->
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0 0 0 6">
                            <Button x:Name="StratExportButton" DockPanel.Dock="Right" Content="Export strat…"
                                    Classes="ghost" FontSize="11" Padding="8 3"
                                    Command="{Binding OpenExportCommand}" IsVisible="{Binding CanExport}"
                                    ToolTip.Tip="Render the strat to a GIF or video, first step to last plus 2 s by default. Runs in the background." />
                            <TextBlock DockPanel.Dock="Right" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMid}"
                                       Text="{Binding ExportUnavailableNote}"
                                       IsVisible="{Binding HasExportUnavailableNote}"
                                       ToolTip.Tip="An export writes a file and may drive ffmpeg; the browser head has neither." />
                        </DockPanel>
                        <Panel>
                            <TextBlock Text="the canvas plays the open strat" FontSize="11"
                                       Foreground="{DynamicResource TextMid}" IsVisible="{Binding !HasOpenStrat}" />
                            <sb:StratCanvasView DataContext="{Binding Canvas}" x:DataType="canvas:StratCanvasViewModel"
                                                IsVisible="{Binding HasDocument}" />
                        </Panel>
                    </DockPanel>

                    <!-- The export pane, as on the 2D tab: not a modal; Start hands off and closes, and progress
                         lives on the status chip. -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="360"
                            BorderThickness="1,0,0,0"
                            Background="{DynamicResource Pb2dPanelBg}"
                            BorderBrush="{DynamicResource Pb2dGridSplitter}"
                            IsVisible="{Binding ExportDialog, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Grid RowDefinitions="*,Auto">
                            <ScrollViewer Grid.Row="0">
                                <ContentControl Content="{Binding ExportDialog}" />
                            </ScrollViewer>
                            <Button Grid.Row="1" Content="Close" Margin="12,0,12,12" HorizontalAlignment="Right"
                                    Command="{Binding CloseExportCommand}" />
                        </Grid>
                    </Border>
                </Panel>
            </Border>
        </Grid>
    </DockPanel>

</UserControl>
