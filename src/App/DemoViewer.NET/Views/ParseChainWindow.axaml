<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemoViewer.NET.ViewModels"
        xmlns:shell="using:DemoViewer.NET.ViewModels.Shell"
        xmlns:controls="using:DemoViewer.NET.Controls"
        x:Class="DemoViewer.NET.Views.ParseChainWindow"
        x:DataType="shell:MainViewModel"
        Title="Parse Chain"
        Width="900" Height="380"
        MinWidth="400" MinHeight="150"
        ShowInTaskbar="False">

    <DockPanel>

        <!-- Placeholder when chain is empty -->
        <TextBlock DockPanel.Dock="Top"
                   IsVisible="{Binding !HasParseChain}"
                   Text="Select a frame, message, or field to see its parse chain."
                   Margin="12,10"
                   FontSize="12"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />

        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding HasParseChain}"
                      Margin="4">
            <ItemsControl ItemsSource="{Binding ParseChain}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ParseChainEntry">
                        <controls:ParseLinkChip Label="{Binding Label}"
                                                Detail="{Binding Detail}"
                                                SourceBadge="{Binding SourceBadge}"
                                                Indent="{Binding Indent}"
                                                Command="{Binding OpenCommand}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

    </DockPanel>
</Window>