<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DemoViewer.NET.Controls"
        xmlns:update="using:DemoViewer.NET.ViewModels.Update"
        x:Class="DemoViewer.NET.Views.Update.WhatsNewWindow"
        x:DataType="update:WhatsNewViewModel"
        Title="What's new"
        Width="620" Height="580"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ShellBg}">

    <!-- Desktop-only window (shown after a desktop update); content inline like UpdateNoticeWindow. -->
    <DockPanel Margin="20">

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <StackPanel DockPanel.Dock="Top" Spacing="4">
            <TextBlock FontSize="20" FontWeight="SemiBold"
                       Text="{Binding HeadlineText}" TextWrapping="Wrap" />
            <TextBlock Opacity="0.7"
                       IsVisible="{Binding PublishedDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding PublishedDisplay}" />
        </StackPanel>

        <!-- ── Footer ─────────────────────────────────────────────────── -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="View on GitHub"
                    Command="{Binding OpenReleasePageCommand}"
                    IsVisible="{Binding ReleaseUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseCommand}" />
        </DockPanel>

        <!-- ── Release notes ───────────────────────────────────────────── -->
        <Border Background="{DynamicResource CardBg}" CornerRadius="6"
                Padding="14" Margin="0,14,0,0">
            <Panel>
                <TextBlock Opacity="0.7" Text="Fetching release notes…"
                           IsVisible="{Binding IsLoading}" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                           IsVisible="{Binding NotesFallback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding NotesFallback}" />
                <ScrollViewer>
                    <controls:MarkdownBlock Markdown="{Binding NotesMarkdown}" />
                </ScrollViewer>
            </Panel>
        </Border>
    </DockPanel>
</Window>
