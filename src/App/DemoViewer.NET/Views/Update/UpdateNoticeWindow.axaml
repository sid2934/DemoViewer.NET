<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:DemoViewer.NET.Controls"
        xmlns:update="using:DemoViewer.NET.ViewModels.Update"
        x:Class="DemoViewer.NET.Views.Update.UpdateNoticeWindow"
        x:DataType="update:UpdateNoticeViewModel"
        Title="Update available"
        Width="620" Height="580"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ShellBg}">

    <!-- Desktop-only window (the updater itself is desktop-only), so the content lives inline
         rather than in a shared UserControl — there is no WASM overlay twin to share it with. -->
    <DockPanel Margin="20">

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <StackPanel DockPanel.Dock="Top" Spacing="4">
            <TextBlock FontSize="20" FontWeight="SemiBold"
                       Text="{Binding HeadlineText}" TextWrapping="Wrap" />
            <TextBlock Opacity="0.7" Text="{Binding SubHeadlineText}" />
            <TextBlock Opacity="0.7"
                       IsVisible="{Binding PublishedDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding PublishedDisplay}" />
        </StackPanel>

        <!-- ── Footer: progress, status, actions ──────────────────────── -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="12"
                        IsVisible="{Binding Update.IsDownloading}">
                <TextBlock VerticalAlignment="Center" Text="Downloading update…" />
                <ProgressBar Width="220" Minimum="0" Maximum="100"
                             Value="{Binding Update.DownloadProgress}" />
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding Update.DownloadProgress, StringFormat='{}{0}%'}" />
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                       IsVisible="{Binding Update.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding Update.StatusMessage}" />
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="View on GitHub"
                        Command="{Binding OpenReleasePageCommand}"
                        IsVisible="{Binding ReleaseUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                    <Button Content="Update &amp; Restart"
                            Command="{Binding Update.UpdateAndRestartCommand}" />
                    <Button Content="Later" Command="{Binding LaterCommand}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <!-- ── Release notes ───────────────────────────────────────────── -->
        <Border Background="{DynamicResource CardBg}" CornerRadius="6"
                Padding="14" Margin="0,14,0,0">
            <Panel>
                <TextBlock Opacity="0.7" Text="Fetching release notes…"
                           IsVisible="{Binding IsLoadingNotes}" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                           IsVisible="{Binding NotesFallback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding NotesFallback}" />
                <ScrollViewer>
                    <controls:MarkdownBlock Markdown="{Binding NotesMarkdown}" />
                </ScrollViewer>
            </Panel>
        </Border>
    </DockPanel>
</Window>
