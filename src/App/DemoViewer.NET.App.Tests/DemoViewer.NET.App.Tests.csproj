<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- Distinct from the DemoViewer.NET.App TYPE to avoid namespace/type collision. -->
        <RootNamespace>DemoViewer.NET.AppTests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- The suite churns multi-GB ParsedDemo + entity-replay transients on a 16 GB dev
             machine that runs memory-pressured; bias the GC toward returning memory to the
             OS over throughput so the test process is never the OS's fattest kill target. -->
        <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="TUnit"/>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Headless"/>
        <PackageReference Include="Avalonia.Skia"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DemoViewer.NET\DemoViewer.NET.csproj"/>
        <!-- A handful of composition-root and core-mechanism tests (AppCompositionRootTests' siblings,
             DemoCachePackPayloadTests, PackDataRemoverTests, ...) build the real pack as their fixture;
             moving the pack's OWN tests out didn't remove this project's need for the pack assembly. -->
        <ProjectReference Include="..\..\Extensions\StratBook\DemoViewer.NET.Extensions.StratBook\DemoViewer.NET.Extensions.StratBook.csproj"/>
        <ProjectReference Include="..\..\Testing\DemoViewer.NET.TestSupport\DemoViewer.NET.TestSupport.csproj"/>
        <!-- Built, not referenced: the third-party extension tests install its output under a temp extensions folder. -->
        <ProjectReference Include="..\..\..\samples\Extensions\HelloExtension\HelloExtension.csproj"
                          ReferenceOutputAssembly="false" Private="false"/>
        <!-- Referenced for its view models, and installed from its own output by the external loading test. -->
        <ProjectReference Include="..\..\Testing\ThirdPartyFake\ThirdPartyFake.csproj"/>
    </ItemGroup>

    <!-- Fixtures that need the StratBook pack, shared with its test project. Owned by neither, so this
         project links nothing from the extension tests. Each file compiles into both assemblies. -->
    <ItemGroup>
        <Compile Include="..\..\Testing\StratBookFixtures\*.cs" LinkBase="StratBookFixtures"/>
    </ItemGroup>

    <!-- The feed-merge logic lives beside the signing tool (tools/extension-signing), not in this
         app, so ExtensionPackagingTests exercises it as linked source rather than a project reference;
         it already resolves ExtensionFeed and ExtensionManifest through the ProjectReference above. -->
    <ItemGroup>
        <Compile Include="..\..\..\tools\extension-signing\FeedMerge.cs" Link="Extensions\FeedMerge.cs"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="DemoViewer.NET.Extensions.Sdk"/>
    </ItemGroup>

    <Import Project="..\..\Testing\DemoViewer.NET.Extensions.Testing\DemoViewer.NET.Extensions.Testing.props"/>

</Project>
