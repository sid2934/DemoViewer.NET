<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- Distinct from the DemoViewer.NET.App TYPE to avoid namespace/type collision. -->
        <RootNamespace>DemoViewer.NET.AppTests</RootNamespace>
        <!-- CA1707: test method names conventionally use underscores (e.g. Method_Condition_Expected) -->
        <NoWarn>$(NoWarn);CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- The suite churns multi-GB ParsedDemo + entity-replay transients on a 16 GB dev
             machine that runs memory-pressured; bias the GC toward returning memory to the
             OS over throughput so the test process is never the OS's fattest kill target. -->
        <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="TUnit"/>
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="Avalonia.Headless"/>
        <PackageReference Include="Avalonia.Skia"/>
        <PackageReference Include="Avalonia.Fonts.Inter"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DemoViewer.NET\DemoViewer.NET.csproj"/>
        <!-- A handful of composition-root and core-mechanism tests (AppCompositionRootTests' siblings,
             DemoCachePackPayloadTests, PackDataRemoverTests, ...) build the real pack as their fixture;
             moving the pack's OWN tests out didn't remove this project's need for the pack assembly. -->
        <ProjectReference Include="..\..\Extensions\StratBook\DemoViewer.NET.Extensions.StratBook\DemoViewer.NET.Extensions.StratBook.csproj"/>
        <ProjectReference Include="..\..\Testing\DemoViewer.NET.TestSupport\DemoViewer.NET.TestSupport.csproj"/>
        <!-- Built, not referenced: the third-party extension tests install its output under a temp extensions folder. -->
        <ProjectReference Include="..\..\..\samples\Extensions\HelloExtension\HelloExtension.csproj"
                          ReferenceOutputAssembly="false" Private="false"/>
        <!-- Referenced for its view models, and installed from its own output by the external loading test. -->
        <ProjectReference Include="..\..\Testing\ThirdPartyFake\ThirdPartyFake.csproj"/>
    </ItemGroup>

    <!-- These four files moved to the extension test project along with the rest of
         Extensions/StratBook; linked back here, each into its own listed core-mechanism tests, because
         those tests stayed in this project and still need them as fixtures. Each file compiles into
         both assemblies. -->
    <ItemGroup>
        <!-- DemoCachePackPayloadTests, DemoCacheRoundIndexStampTests, PackDataRemoverTests,
             ReviewQueueTests, SidecarFormatTests, BackgroundPlanRealDemoTests, ForwardPassRealDemoTests,
             ForwardQueueTests. -->
        <Compile Include="..\..\Extensions\StratBook\DemoViewer.NET.Extensions.StratBook.Tests\RoundIndexTestData.cs" Link="RoundIndexTestData.cs"/>
        <Compile Include="..\..\Extensions\StratBook\DemoViewer.NET.Extensions.StratBook.Tests\CacheRecordTestExtensions.cs" Link="CacheRecordTestExtensions.cs"/>
        <Compile Include="..\..\Extensions\StratBook\DemoViewer.NET.Extensions.StratBook.Tests\LibraryTestExtensions.cs" Link="LibraryTestExtensions.cs"/>
        <!-- UiThreadAuditTests walks the StratBook hub like every other section's. -->
        <Compile Include="..\..\Extensions\StratBook\DemoViewer.NET.Extensions.StratBook.Tests\StratBookHubAccess.cs" Link="StratBookHubAccess.cs"/>
        <!-- ZonePlaceResolverSourceTests (core: Services/Zones) checks the adjacency-seam naming through
             the Query Canvas, the same fixture ToleranceSliderTests builds. -->
        <Compile Include="..\..\Extensions\StratBook\DemoViewer.NET.Extensions.StratBook.Tests\ToleranceSliderHarness.cs" Link="ToleranceSliderHarness.cs"/>
    </ItemGroup>

    <!-- The feed-merge logic lives beside the signing tool (tools/extension-signing), not in this
         app, so ExtensionPackagingTests exercises it as linked source rather than a project reference;
         it already resolves ExtensionFeed and ExtensionManifest through the ProjectReference above. -->
    <ItemGroup>
        <Compile Include="..\..\..\tools\extension-signing\FeedMerge.cs" Link="Extensions\FeedMerge.cs"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="DemoViewer.NET.Extensions.Sdk"/>
    </ItemGroup>

    <Import Project="..\..\Testing\DemoViewer.NET.Extensions.Testing\DemoViewer.NET.Extensions.Testing.props"/>

</Project>
