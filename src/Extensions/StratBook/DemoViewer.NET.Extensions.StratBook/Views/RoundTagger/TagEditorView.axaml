<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DemoViewer.NET.Extensions.StratBook.Modules.RoundTagger.Review"
             x:Class="DemoViewer.NET.Extensions.StratBook.Views.RoundTagger.TagEditorView"
             x:DataType="vm:TagEditorViewModel">

    <!--
      THE TAG EDITOR: one form for a suggestion, a written label and a new label. The code; the start and end
      in seconds from the round start, each with a button that sets it to the playhead; the labels as chips,
      added from the palette's groups and values or typed for a group the palette does not list; the note; the
      map positions (a click on the map adds one while this is open). Enter in a box saves, Esc cancels.

      Colour: every value is a {DynamicResource} token; state is carried by words, never by tint.
    -->

    <Border Padding="8,6" CornerRadius="4" Background="{DynamicResource Pb2dCardBg}"
            BorderBrush="{DynamicResource Pb2dHudDivider}" BorderThickness="1">
        <StackPanel Spacing="5">
            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{DynamicResource Pb2dTextBrightest}" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="code" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource Pb2dTextDim}" />
                <ComboBox Grid.Column="1" x:Name="CodeBox" HorizontalAlignment="Stretch" FontSize="11"
                          ItemsSource="{Binding Codes}" SelectedItem="{Binding SelectedCode}"
                          PlaceholderText="pick a code" />
            </Grid>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto,*,Auto" ColumnSpacing="4">
                <TextBlock Grid.Column="0" Text="start" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource Pb2dTextDim}" />
                <TextBox Grid.Column="1" x:Name="FromBox" Text="{Binding FromText}" FontSize="11" />
                <Button Grid.Column="2" Content="here" Padding="4,0" FontSize="10" Focusable="False"
                        Command="{Binding SetStartHereCommand}" ToolTip.Tip="Set the start to the playhead" />
                <TextBlock Grid.Column="3" Text="end" FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                           Foreground="{DynamicResource Pb2dTextDim}" />
                <TextBox Grid.Column="4" Text="{Binding ToText}" FontSize="11" />
                <Button Grid.Column="5" Content="here" Padding="4,0" FontSize="10" Focusable="False"
                        Command="{Binding SetEndHereCommand}" ToolTip.Tip="Set the end to the playhead" />
            </Grid>
            <TextBlock Text="seconds from the round start" FontSize="9" Foreground="{DynamicResource Pb2dTextDim}" />

            <ItemsControl ItemsSource="{Binding Labels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TagLabelChip">
                        <Border CornerRadius="10" Padding="7,1,3,1" Margin="0,0,4,3"
                                Background="{DynamicResource Pb2dPanelBg}">
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <TextBlock Text="{Binding Text}" FontSize="10" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Pb2dTextBright}" />
                                <Button Content="✕" Padding="3,0" FontSize="9" Focusable="False" Background="Transparent"
                                        Command="{Binding $parent[UserControl].((vm:TagEditorViewModel)DataContext).RemoveLabelCommand}"
                                        CommandParameter="{Binding}" ToolTip.Tip="Remove this label" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="4">
                <AutoCompleteBox Grid.Column="0" Text="{Binding NewGroup}" ItemsSource="{Binding Groups}"
                                 FontSize="11" Watermark="group" MinimumPrefixLength="0" FilterMode="StartsWith" />
                <AutoCompleteBox Grid.Column="1" Text="{Binding NewValue}" ItemsSource="{Binding ValuesForGroup}"
                                 FontSize="11" Watermark="value" MinimumPrefixLength="0" FilterMode="StartsWith" />
                <Button Grid.Column="2" Content="Add" Padding="6,0" FontSize="10" Focusable="False"
                        Command="{Binding AddLabelCommand}" ToolTip.Tip="Add this label" />
            </Grid>

            <TextBox Text="{Binding Note}" FontSize="11" Watermark="note (optional)" TextWrapping="Wrap" />

            <StackPanel Spacing="2" IsVisible="{Binding HasPositions}">
                <TextBlock Text="positions (click the map to add)" FontSize="9" Foreground="{DynamicResource Pb2dTextDim}" />
                <ItemsControl ItemsSource="{Binding Positions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TagPositionRow">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="✕" Padding="3,0" FontSize="9" Focusable="False"
                                        Command="{Binding $parent[UserControl].((vm:TagEditorViewModel)DataContext).RemovePositionCommand}"
                                        CommandParameter="{Binding}" ToolTip.Tip="Remove this position" />
                                <TextBlock Text="{Binding Text}" FontSize="10" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Pb2dTextBright}" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock Text="{Binding Problem}" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding HasProblem}"
                       Foreground="{DynamicResource Pb2dBomb}" />

            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Content="Save" Padding="10,1" Focusable="False"
                        Command="{Binding SaveCommand}" ToolTip.Tip="Save (Enter)" />
                <Button DockPanel.Dock="Left" Content="Cancel" Padding="8,1" Margin="4,0,0,0" Focusable="False"
                        Command="{Binding CancelCommand}" ToolTip.Tip="Close without saving (Esc)" />
                <Button DockPanel.Dock="Right" Content="Delete" Padding="8,1" Focusable="False"
                        IsVisible="{Binding CanDelete}" Command="{Binding DeleteCommand}"
                        ToolTip.Tip="Delete this label (Ctrl+Z undoes it)" />
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
