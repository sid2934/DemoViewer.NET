<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DemoViewer.NET.Extensions.StratBook.Modules.StratBook.Canvas"
             xmlns:ui="using:DemoViewer.NET.Extensions.Sdk.Ui.Controls"
             x:Class="DemoViewer.NET.Extensions.StratBook.Views.StratBook.StratCanvasView"
             x:DataType="vm:StratCanvasViewModel"
             Focusable="True">

    <!--
      THE STEP AUTHORING CANVAS: the open strat on the 2D scene with no demo behind
      it. The tool row, the step transport and the path picker on top; the scene in the middle, drawing the
      canvas view-model as its source with the canvas as its token editor; the scrubber at the bottom, one
      marker per step and one per stroke.

      Keys go through the one keymap (with the user's rebinds) while the canvas has focus:
      Esc also ends Set On Map without writing.
      V token, D draw, X erase, A T L R O the shapes, Space play, [ ] steps, Shift+N add a step, Ctrl+D
      duplicate it, Ctrl+Delete delete it, Ctrl+X clear its strokes, Ctrl+Z and Ctrl+Shift+Z the strat's
      one history.

      Colour: every value is a {DynamicResource} token; state is carried by words and toggles, never tint.
    -->

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Tools. The same glyphs as the 2D tab's annotation toolbar; the token tool is this canvas's own. -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" Margin="0 0 0 6">
            <ToggleButton Padding="8,2" Content="✋" IsVisible="{Binding !IsReadOnly}"
                          IsChecked="{Binding Tools.IsPanZoomSelected, Mode=OneWay}"
                          Command="{Binding Tools.SelectPanZoomCommand}"
                          ToolTip.Tip="Pan / zoom" />
            <ToggleButton Padding="8,2" Content="◉"
                          IsVisible="{Binding !IsReadOnly}"
                          IsChecked="{Binding IsTokenToolSelected, Mode=OneWay}"
                          Command="{Binding SelectTokenToolCommand}"
                          ToolTip.Tip="{Binding Tools.TokenToolTip}" />
            <!-- Alt+drag's twin, for a window manager that takes Alt+drag: the next drag pins its token. -->
            <ToggleButton x:Name="PinToggle" Padding="8,2" Content="Pin" FontSize="11"
                          IsVisible="{Binding !IsReadOnly}"
                          IsChecked="{Binding PinNextDrag}"
                          ToolTip.Tip="Pin the next token drag to an exact spot, as Alt+drag does: a placed chip on the step, cleared with its ✕" />
            <ToggleButton Padding="8,2" Content="✎"
                          IsVisible="{Binding !IsReadOnly}"
                          IsChecked="{Binding Tools.IsDrawSelected, Mode=OneWay}"
                          Command="{Binding Tools.SelectDrawCommand}"
                          ToolTip.Tip="{Binding Tools.DrawToolTip}" />
            <ToggleButton Padding="8,2" Content="⌫"
                          IsVisible="{Binding !IsReadOnly}"
                          IsChecked="{Binding Tools.IsEraseSelected, Mode=OneWay}"
                          Command="{Binding Tools.SelectEraseCommand}"
                          ToolTip.Tip="{Binding Tools.EraseToolTip}" />
            <ToggleButton Padding="8,2" Content="➚"
                          IsVisible="{Binding !IsReadOnly}"
                          IsChecked="{Binding Tools.IsArrowSelected, Mode=OneWay}"
                          Command="{Binding Tools.SelectArrowCommand}"
                          ToolTip.Tip="{Binding Tools.ArrowToolTip}" />
            <ToggleButton Padding="8,2" Content="T"
                          IsVisible="{Binding !IsReadOnly}"
                          IsChecked="{Binding Tools.IsTextSelected, Mode=OneWay}"
                          Command="{Binding Tools.SelectTextCommand}"
                          ToolTip.Tip="{Binding Tools.TextToolTip}" />
            <ToggleButton Padding="8,2" Content="╱"
                          IsVisible="{Binding !IsReadOnly}"
                          IsChecked="{Binding Tools.IsLineSelected, Mode=OneWay}"
                          Command="{Binding Tools.SelectLineCommand}"
                          ToolTip.Tip="{Binding Tools.LineToolTip}" />
            <ToggleButton Padding="8,2" Content="▭"
                          IsVisible="{Binding !IsReadOnly}"
                          IsChecked="{Binding Tools.IsRectSelected, Mode=OneWay}"
                          Command="{Binding Tools.SelectRectCommand}"
                          ToolTip.Tip="{Binding Tools.RectToolTip}" />
            <ToggleButton Padding="8,2" Content="◯"
                          IsVisible="{Binding !IsReadOnly}"
                          IsChecked="{Binding Tools.IsEllipseSelected, Mode=OneWay}"
                          Command="{Binding Tools.SelectEllipseCommand}"
                          ToolTip.Tip="{Binding Tools.EllipseToolTip}" />
            <!-- Set On Map: the selected step's place from a click, for the field its verb uses. -->
            <ToggleButton Content="{Binding SetPlaceText}" FontSize="11" Padding="8 3"
                          IsVisible="{Binding CanSetPlace}"
                          IsChecked="{Binding IsSettingPlace, Mode=OneWay}"
                          Command="{Binding ToggleSetPlaceCommand}"
                          ToolTip.Tip="{Binding SetPlaceToolTip}" />
            <Button Content="Place tokens"
                    IsVisible="{Binding !IsReadOnly}" Classes="ghost" FontSize="11" Padding="8 3"
                    Command="{Binding PlaceTokensCommand}"
                    ToolTip.Tip="Put every token the strat has not placed yet on the map at the active step, to drag from there" />
            <Button Content="Fit" Classes="ghost" FontSize="11" Padding="8 3" Click="OnFitClick"
                    ToolTip.Tip="Frame the whole map" />
        </WrapPanel>

        <!-- The step transport and the path. -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" Margin="0 0 0 6">
            <Button Content="⏮" Classes="ghost" Padding="8 3" Command="{Binding PrevStepCommand}" ToolTip.Tip="Previous step ([)" />
            <Button Content="{Binding PlayGlyph}" Classes="ghost" Padding="8 3" Command="{Binding TogglePlayCommand}"
                    ToolTip.Tip="Play / pause (Space)" />
            <Button Content="⏭" Classes="ghost" Padding="8 3" Command="{Binding NextStepCommand}" ToolTip.Tip="Next step (])" />
            <TextBlock Text="{Binding ClockText}" FontSize="12" VerticalAlignment="Center" MinWidth="120"
                       Foreground="{DynamicResource TextValue}" />
            <TextBlock Text="{Binding SpeedText}" FontSize="11" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMid}" ToolTip.Tip="Speed (↑ / ↓)" />
            <Button Content="Add step" Classes="ghost" FontSize="11" Padding="8 3" IsVisible="{Binding !IsReadOnly}" Command="{Binding AddStepCommand}"
                    ToolTip.Tip="Insert a step after the active one at the playhead's time (Shift+N)" />
            <Button Content="Duplicate" Classes="ghost" FontSize="11" Padding="8 3" IsVisible="{Binding !IsReadOnly}" Command="{Binding DuplicateStepCommand}"
                    ToolTip.Tip="Copy the active step's positions and strokes into a new step 5 s later (Ctrl+D)" />
            <Button Content="Delete step" Classes="ghost" FontSize="11" Padding="8 3" IsVisible="{Binding !IsReadOnly}" Command="{Binding DeleteStepCommand}"
                    ToolTip.Tip="Delete the active step and the branches that name it (Ctrl+Delete)" />
            <ComboBox ItemsSource="{Binding PathOptions}" SelectedItem="{Binding SelectedPath}" FontSize="11"
                      MinWidth="160" IsVisible="{Binding HasBranches}"
                      ToolTip.Tip="Which path to play: the main line, or through a branch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:StratPathOption">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding StatusLine}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMid}" />
        </WrapPanel>

        <!-- The scene. The code-behind hands it the canvas, this view's DataContext, as its source. -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" ClipToBounds="True">
            <Panel>
                <ui:SceneView x:Name="Scene" />

                <!-- A token drag's label beside the pointer: who, the field it writes and what it becomes, then the keys. -->
                <Canvas x:Name="DragLabelLayer" IsHitTestVisible="False">
                    <Border x:Name="DragLabel" IsVisible="{Binding DragLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Padding="8 4" CornerRadius="3"
                            Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Pb2dCanvasDropTarget}" BorderThickness="1">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding DragLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextValue}" />
                            <TextBlock Text="{Binding DragHint}" FontSize="10" Foreground="{DynamicResource TextMid}"
                                       IsVisible="{Binding DragHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>
                </Canvas>

                <!-- The text tool's editor, as on the 2D tab: shown over the label being placed, Enter
                     commits, Esc cancels, losing focus commits. -->
                <Canvas x:Name="TextEditorLayer">
                    <TextBox x:Name="AnnotationTextEditor" IsVisible="False" MinWidth="120"
                             AcceptsReturn="False" Padding="4,1" MinHeight="0"
                             Background="{DynamicResource Pb2dOverlayBg}"
                             PlaceholderText="Label text, Enter to place" />
                </Canvas>
            </Panel>
        </Border>

        <ui:TimelineView Grid.Row="3" Timeline="{Binding Timeline}" Margin="0 6 0 0" />
    </Grid>
</UserControl>
