<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <!-- Its own namespace, so a type of the app it still uses needs a using and shows up as one. The
             assembly name is what the heads reference and the ViewLocator searches. -->
        <RootNamespace>DemoViewer.NET.Extensions.StratBook</RootNamespace>
        <AssemblyName>DemoViewer.NET.Extensions.StratBook</AssemblyName>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <!-- The built-in tag palette, embedded so TagPaletteStore reads it through the same
         parser and validator user drop-ins go through. The LogicalName is the manifest name readers and
         TagPaletteStoreTests have always seen; it does not follow the directory. -->
    <ItemGroup>
        <EmbeddedResource Include="Assets\Palettes\*.tagpalette.json"
                          LogicalName="DemoViewer.NET.Services.Tags.Palettes.%(Filename)%(Extension)"/>
    </ItemGroup>

    <!-- The canonical place names per shipped map; CanonicalPlaces reads them by manifest
         name suffix. Same LogicalName rule as the palette. -->
    <ItemGroup>
        <EmbeddedResource Include="Assets\Callouts\*.places.json"
                          LogicalName="DemoViewer.NET.Services.Strats.Callouts.%(Filename)%(Extension)"/>
    </ItemGroup>

    <!-- Contributed rulesets; RoundIndexTable opens them by this name. -->
    <ItemGroup>
        <EmbeddedResource Include="Assets\Rulesets\*.rules.yaml"
                          LogicalName="DemoViewer.NET.Extensions.StratBook.Rulesets.%(Filename)%(Extension)"/>
    </ItemGroup>

    <!-- The manifest:..\extension.json is a template whose version is stamped from
         ..\version.json at build. The stamped copy is embedded (StratBookPack.Manifest) and copied beside the
         DLL for the loader. The targets are the SDK package's, imported from source here. -->
    <PropertyGroup>
        <ExtensionManifestTemplate>$(MSBuildProjectDirectory)/../extension.json</ExtensionManifestTemplate>
    </PropertyGroup>
    <Import Project="..\..\..\Sdk\DemoViewer.NET.Extensions.Sdk\build\DemoViewer.NET.Extensions.Sdk.targets"/>

    <ItemGroup>
        <!-- Direct, not transitive: the Avalonia build tasks (XAML compilation) and the MVVM source generators
             only run in a project that references the package itself. -->
        <PackageReference Include="Avalonia"/>
        <PackageReference Include="CommunityToolkit.Mvvm"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="Microsoft.Extensions.Logging"/>
        <PackageReference Include="Microsoft.Extensions.Options"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="DemoViewer.NET.Extensions.Sdk"/>
        <Using Include="DemoViewer.NET.Extensions.Sdk.Ui"/>
        <Using Include="DemoViewer.NET.Extensions.Sdk.Ui.Controls"/>
        <Using Include="DemoViewer.NET.Extensions.Sdk.Ui.Theming"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The SDK and its UI kit, with the scene package through the SDK, are the packages a third party
             takes; the projects stand in for them, as for the sample. Everything Playback2D the extension
             draws with comes from those, and so are the review queue and its pack export. What is left of
             the app reference is the playback host the strat canvas mounts and the zones overlay folder; it
             grants the extension no internals, and PackPlayback2DBindingTests pins what it may still bind,
             which in the unpublished Playback2D assembly is now nothing. The app never references the
             extension; the heads reference both and hand the pack list to FeaturePacks. -->
        <ProjectReference Include="..\..\..\Sdk\DemoViewer.NET.Extensions.Sdk\DemoViewer.NET.Extensions.Sdk.csproj"/>
        <ProjectReference Include="..\..\..\Sdk\DemoViewer.NET.Extensions.Sdk.Ui\DemoViewer.NET.Extensions.Sdk.Ui.csproj"/>
        <ProjectReference Include="..\..\..\App\DemoViewer.NET\DemoViewer.NET.csproj"/>
    </ItemGroup>

    <!-- Same rule as the app csproj: the Avalonia XAML rewrite re-embeds the .pdb path after Roslyn, which
         undoes ContinuousIntegrationBuild. No debug directory in Release leaves nothing to re-embed. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>none</DebugType>
    </PropertyGroup>
</Project>
