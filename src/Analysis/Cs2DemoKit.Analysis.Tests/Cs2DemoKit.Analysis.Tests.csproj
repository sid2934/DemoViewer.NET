<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- CA1707: test method names conventionally use underscores (e.g. Method_Condition_Expected) -->
        <NoWarn>$(NoWarn);CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Cs2DemoKit.Analysis\Cs2DemoKit.Analysis.csproj"/>
        <ProjectReference Include="..\Cs2DemoKit.Analysis.Rules\Cs2DemoKit.Analysis.Rules.csproj"/>
        <ProjectReference Include="..\..\Testing\DemoViewer.NET.TestSupport\DemoViewer.NET.TestSupport.csproj"/>
        <!-- Catalog drift gate: the test regenerates the catalog from the live registries and
             byte-compares it against the committed rules/catalog.json. -->
        <ProjectReference Include="..\..\..\tools\DemoViewer.NET.RulesCatalog\DemoViewer.NET.RulesCatalog.csproj"/>
        <!-- RulesCheckV2Tests runs the built AnalysisBench 'rules check' CLI. Build-order dependency
             (ReferenceOutputAssembly=false, so the Exe's assemblies aren't referenced) forces a FRESH
             AnalysisBench build, so the test can neither silently skip on a missing binary nor pass
             green against a stale one. -->
        <ProjectReference Include="..\..\..\tools\AnalysisBench\AnalysisBench.csproj" ReferenceOutputAssembly="false"/>
    </ItemGroup>

</Project>
