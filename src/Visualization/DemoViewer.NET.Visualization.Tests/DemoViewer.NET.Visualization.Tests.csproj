<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- CA1707: test method names conventionally use underscores. NU1903: transitively pulls in
             Tmds.DBus.Protocol 0.21.2 (GHSA-xrw6-gwf8-vvr9) via the ProjectReference to the Sample,
             which itself references Avalonia.Desktop — same suppression as the Sample and Desktop
             csproj carry; NoWarn does not flow across project references, so this project needs its
             own copy. -->
        <NoWarn>$(NoWarn);CA1707;NU1903</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DemoViewer.NET.Visualization\DemoViewer.NET.Visualization.csproj"/>
        <ProjectReference Include="..\DemoViewer.NET.Visualization.Sample\DemoViewer.NET.Visualization.Sample.csproj"/>
    </ItemGroup>

</Project>
