<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DemoViewer.NET.Visualization\DemoViewer.NET.Visualization.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The captured Analysis-tab graph behind ShippedScaleGraph. LogicalName is explicit because
             ShippedScaleGraph names the resource as a string constant, and a derived name would couple
             that constant to this project's RootNamespace. -->
        <EmbeddedResource Include="SampleGraphs\shipped-scale.tsv"
                          LogicalName="DemoViewer.NET.Visualization.Tests.SampleGraphs.shipped-scale.tsv"/>
    </ItemGroup>

</Project>
