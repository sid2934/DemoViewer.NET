<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The 2D map renderer over the published scene contract (DemoViewer.NET.Playback2D.Scene), plus the
      demo-domain adaptation it feeds: the concrete layers, input tools, annotations, render backends and
      export requests, frame building, map-asset decode, fixtures, the private tracker replay and the
      encoder sinks. References the scene contract, SkiaSharp, the CS2DemoKit parser packages and the
      (Avalonia-free) module abstractions. Still NO Avalonia, enforced by test: that is what lets export,
      the CLI and CI render without a window.
    -->
    <PropertyGroup>
        <RootNamespace>DemoViewer.NET.Playback2D.Pipeline</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp"/>
        <PackageReference Include="CS2DemoKit.Parser"/>
        <PackageReference Include="CS2DemoKit.Analysis"/>
        <!-- Export sinks. FFMpegCore only builds arguments and pipes rawvideo to an ffmpeg
             SUBPROCESS; the no-ffmpeg GIF floor is our own writer (Export/Gif). Managed-only, so the
             Browser head still restores and publishes. Nothing calls System.Diagnostics.Process unless
             a sink is constructed, and playback2d.export is gated off on browser. -->
        <PackageReference Include="FFMpegCore"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The baked CS2 iconography, for SkiaIconSource. Asset-only and dependency-free,
             so it cannot reintroduce Avalonia into the headless graph. -->
        <ProjectReference Include="..\..\GameIcons\DemoViewer.NET.GameIcons\DemoViewer.NET.GameIcons.csproj"/>
        <!-- The published scene contract: frame, layer interface, compositor, floors, places, viewport. -->
        <ProjectReference
                Include="..\DemoViewer.NET.Playback2D.Scene\DemoViewer.NET.Playback2D.Scene.csproj"/>
        <ProjectReference
                Include="..\..\App\DemoViewer.NET.Modules.Abstractions\DemoViewer.NET.Modules.Abstractions.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DemoViewer.NET.Playback2D.Tests"/>
        <!-- The perf recorder and its report are internal because they expose the scene's
             internal profiler types; the perf output of dv2d is their one consumer. -->
        <InternalsVisibleTo Include="dv2d"/>
        <!-- PackExportTests (App.Tests) white-box-tests PackSegmentSink and PackTitleCardRenderer,
             internal here since Pack Export's plan-then-stitch logic (Export/Pack/*.cs) moved into
             Pipeline for dv2d pack; see the note on PackExporter.cs. -->
        <InternalsVisibleTo Include="DemoViewer.NET.App.Tests"/>
    </ItemGroup>

</Project>
