<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The renderer-agnostic scene core: the concrete layers, input tools, annotations, export requests and
      render backends over the published scene contract (DemoViewer.NET.Playback2D.Scene). References
      SkiaSharp and the scene contract and NOTHING else: no Avalonia, no parser, no Modules.Abstractions.
      That constraint is the whole value of this assembly (it is what lets export, the CLI and CI render without a window) and it
      is enforced by ArchitectureTests, not by convention.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>DemoViewer.NET.Playback2D.Core</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SkiaSharp"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The published scene contract: frame, layer interface, compositor, floors, places, viewport. -->
        <ProjectReference Include="..\DemoViewer.NET.Playback2D.Scene\DemoViewer.NET.Playback2D.Scene.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DemoViewer.NET.Playback2D.Pipeline"/>
        <InternalsVisibleTo Include="DemoViewer.NET.Playback2D.Tests"/>
    </ItemGroup>

</Project>
