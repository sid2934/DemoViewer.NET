<Project>
    <!-- See https://aka.ms/dotnet/msbuild/customize for more details on customizing your build -->
    <ItemGroup>
        <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all"/>
    </ItemGroup>

    <!--
        The test-tier taxonomy, compiled into every test
        assembly as LINKED SOURCE rather than reached through a shared test-support assembly.

        Linked, because two suites cannot take the reference: the Playback2D and dv2d suites assert
        that no Avalonia assembly is loaded in their process and that their dependency graph is
        Avalonia-free, and a shared test-support assembly is exactly the kind of edge that silently
        acquires one. Source has no graph.

        Here rather than in six csproj files, because the guard's whole job is to catch a taxonomy
        that has drifted, and "the new test project forgot to link the file that checks for drift"
        is the first way that happens. A project named *.Tests gets it by existing.
    -->
    <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
        <Compile Include="$(MSBuildThisFileDirectory)tests/shared/*.cs" LinkBase="TestTiers"/>

        <!-- Imported globally so TestLanes needs no per-file using at each attribute site. -->
        <Using Include="DemoViewer.NET.Testing.Tiers"/>
    </ItemGroup>

    <!--
        The language and framework settings every project wants, here rather than restated per csproj.
        A project overrides any of them from its own body, which is evaluated after this file: the
        Browser head does that for its net10.0-browser TFM.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>

        <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <AnalysisMode>Recommended</AnalysisMode>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>CS1591</NoWarn>

        <!--
            Restore-time version problems must fail the build, not warn.

            The CS2DemoKit packages are exact-pinned to each other pre-1.0, so bumping one and
            forgetting its siblings resolves to a version nobody pinned. That is only NU1608
            ("detected package version outside of dependency constraint"), a warning — restore
            succeeds, the build succeeds, and the skew surfaces much later as a runtime
            MissingMethodException from a call site that looks fine. NU1605 is the same shape for a
            downgrade. Named explicitly rather than relying on TreatWarningsAsErrors above, because
            that property's reach over restore-time NU* diagnostics is a NuGet implementation
            detail and this guarantee is worth stating outright.
        -->
        <WarningsAsErrors>$(WarningsAsErrors);NU1608;NU1605</WarningsAsErrors>

        <!--
            The PublicAPI gate, named for the same reason: nothing else in the repo mentions it, so a
            NoWarn, AnalysisMode or AnalysisLevel change would un-gate every PublicAPI file silently.
            RS0016 fires on a public member missing from the lists, RS0017 on a list entry whose member
            is gone, which is what makes deleting a shipped member a build error now that the four
            packages are published. Both confirmed by making them fire. RS0037 is deliberately not here:
            dropping #nullable enable from a list emits nothing.
        -->
        <WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>

        <!--
            Nothing in this repo is published to NuGet unless it opts in. Only the four
            SDK library projects set IsPackable=true (see Directory.Build.targets for the
            metadata they then inherit); the app, tools, tests and sample heads stay unpackable so
            a solution-wide `dotnet pack` can never produce a surprise artifact. GameIcons is
            deliberately among the unpackable: it carries Valve artwork.

            IsPackable is read only by the pack targets, so this affects build/publish in no way.
        -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!--
        CA1707 for test projects only: test method names carry underscores by convention
        (Method_Condition_Expected), and TreatWarningsAsErrors above makes the analyzer's objection
        fatal.

        Must stay AFTER the group above. That one assigns NoWarn without reading $(NoWarn), so a group
        placed earlier is overwritten rather than appended to.
    -->
    <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
        <NoWarn>$(NoWarn);CA1707</NoWarn>
    </PropertyGroup>

    <!--
        Build-path privacy for RELEASE builds.

        Every assembly records the absolute path of its .pdb in the CodeView debug directory, and
        that string ships inside the .dll even though the .pdb itself does not (vpk excludes *.pdb).
        Without this, first-party assemblies carry e.g.
        /Users/<name>/Development/DemoViewer.NET/artifacts/obj/.../X.pdb.

        ContinuousIntegrationBuild normalizes those to /_/... A CI build already produced anonymous
        /Users/runner/... paths, so the practical exposure was a hand-uploaded local build; this
        closes that rather than relying on remembering never to do it.

        Release-only on purpose: it implies deterministic source paths, which is exactly what you do
        NOT want while debugging locally — a Debug build keeps real paths so the debugger resolves
        sources without SourceLink.
    -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>
</Project>
