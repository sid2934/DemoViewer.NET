<Project>
    <!-- See https://aka.ms/dotnet/msbuild/customize for more details on customizing your build -->
    <ItemGroup>
        <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all"/>
    </ItemGroup>

    <!--
        The test-tier taxonomy (docs/playback2d-v2/plans/P3-test-tiers.md), compiled into every test
        assembly as LINKED SOURCE rather than reached through a shared test-support assembly.

        Linked, because two suites cannot take the reference: the Playback2D and dv2d suites assert
        that no Avalonia assembly is loaded in their process and that their dependency graph is
        Avalonia-free, and a shared test-support assembly is exactly the kind of edge that silently
        acquires one. Source has no graph.

        Here rather than in six csproj files, because the guard's whole job is to catch a taxonomy
        that has drifted — and "the new test project forgot to link the file that checks for drift"
        is the first way that happens. A project named *.Tests gets it by existing.
    -->
    <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
        <Compile Include="$(MSBuildThisFileDirectory)tests/shared/*.cs" LinkBase="TestTiers"/>
    </ItemGroup>

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
        <AnalysisMode>Recommended</AnalysisMode>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>CS1591</NoWarn>

        <!--
            Restore-time version problems must fail the build, not warn.

            The CS2DemoKit packages are exact-pinned to each other pre-1.0, so bumping one and
            forgetting its siblings resolves to a version nobody pinned. That is only NU1608
            ("detected package version outside of dependency constraint"), a warning — restore
            succeeds, the build succeeds, and the skew surfaces much later as a runtime
            MissingMethodException from a call site that looks fine. NU1605 is the same shape for a
            downgrade. Named explicitly rather than relying on TreatWarningsAsErrors above, because
            that property's reach over restore-time NU* diagnostics is a NuGet implementation
            detail and this guarantee is worth stating outright.
        -->
        <WarningsAsErrors>$(WarningsAsErrors);NU1608;NU1605</WarningsAsErrors>

        <!--
            Nothing in this repo is published to NuGet unless it opts in. Only the three
            Cs2DemoKit library projects set IsPackable=true (see Directory.Build.targets for the
            metadata they then inherit); the app, tools, tests and sample heads stay unpackable so
            a solution-wide `dotnet pack` can never produce a surprise artifact.

            IsPackable is read only by the pack targets, so this affects build/publish in no way.
        -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!--
        Build-path privacy for RELEASE builds (docs/upstream/build-path-leak-report.md).

        Every assembly records the absolute path of its .pdb in the CodeView debug directory, and
        that string ships inside the .dll even though the .pdb itself does not (vpk excludes *.pdb).
        Without this, all 13 first-party assemblies in a publish carried e.g.
        /Users/<name>/Development/DemoViewer.NET/artifacts/obj/.../X.pdb — the same defect this
        project reported to two upstream packages, so shipping it ourselves would be inconsistent.

        ContinuousIntegrationBuild normalizes those to /_/... A CI build already produced anonymous
        /Users/runner/... paths, so the practical exposure was a hand-uploaded local build; this
        closes that rather than relying on remembering never to do it.

        Release-only on purpose: it implies deterministic source paths, which is exactly what you do
        NOT want while debugging locally — a Debug build keeps real paths so the debugger resolves
        sources without SourceLink.
    -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>
</Project>
