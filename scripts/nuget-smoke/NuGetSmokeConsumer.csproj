<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Restore+run proof for the packed Cs2DemoKit.* nupkgs (docs/distribution/nuget-packaging-plan.md).

        NOT a Velopack/app sample and deliberately outside DemoViewer.NET.slnx: nuget.yml builds
        this directly (`dotnet build` / `dotnet run` pointed at scripts/nuget-smoke), so it never
        participates in a solution-wide `dotnet build`/`dotnet test`, and its own nuget.config
        (below) — not the repo root one — governs its restore.

        Central package management stays ON (inherited from the repo-root Directory.Packages.props)
        so the inherited `Nerdbank.GitVersioning` PackageReference (from Directory.Build.props)
        keeps resolving its version centrally; the one package this project actually cares about
        uses VersionOverride (CPM's documented per-reference escape hatch) so Cs2DemoKitVersion can
        drive it without adding an entry to the shared Directory.Packages.props file. Analyzer/
        warning settings inherited from the repo-root Directory.Build.props are turned back off
        here — this project's only job is to prove restore+run, not to pass the library-tier lint
        bar.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <EnableNETAnalyzers>false</EnableNETAnalyzers>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- Version of the packed family to restore. The workflow passes -p:Cs2DemoKitVersion=X to
         match whatever was just packed; local runs default to 0.7.0 (the library line's first
         version). -->
    <PropertyGroup>
        <Cs2DemoKitVersion Condition="'$(Cs2DemoKitVersion)' == ''">0.7.0</Cs2DemoKitVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- Only the top of the family DAG. Cs2DemoKit.Parser and Cs2DemoKit.Analysis.Rules come
             in transitively (exact-pinned by the packed nuspec) — restoring only this proves the
             dependency graph the way a real consumer's `dotnet add package Cs2DemoKit.Analysis`
             would. VersionOverride (not Version) because CPM is on for this project. -->
        <PackageReference Include="Cs2DemoKit.Analysis" VersionOverride="$(Cs2DemoKitVersion)"/>
    </ItemGroup>

</Project>
