<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <!--To inherit the global NuGet package sources remove the <clear/> line below -->
        <clear />
        <add key="nuget" value="https://api.nuget.org/v3/index.json" />
        <!-- Repo-local feed for packages not yet published to nuget.org (CS2OpenDev.Sdk).
             Committed .nupkg files make bare-clone builds work with no sibling checkout.
             Refresh: `dotnet pack` in the CS2OpenDev-SDK repo, copy the new .nupkg here,
             bump the version in Directory.Packages.props. -->
        <add key="local" value="local-packages" />
        <!-- Add your GitHub Packages feed -->
        <add key="private-github" value="https://nuget.pkg.github.com/sid2934/index.json" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget">
            <package pattern="*" />
        </packageSource>
        <!-- CS2OpenDev.Sdk and Cs2VideoGenerator.Core live ONLY in local-packages/, not on
             nuget.org. Without these explicit patterns, packageSourceMapping routes them via the
             nuget `*` pattern to nuget.org and a clean restore (fresh CI runner, no global cache)
             fails with NU1102. Most-specific match wins, so these resolve from the committed
             .nupkg files while everything else still goes to nuget. The CSVG feed's private-github
             source (below) needs a read:packages PAT that bare clones and CI runners lack, so the
             committed nupkg — refreshed from the Cs2VideoGenerator GitHub release — is the source
             of record; keep the pattern here in sync with Directory.Packages.props. -->
        <packageSource key="local">
            <package pattern="CS2OpenDev*" />
            <package pattern="Cs2VideoGenerator*" />
        </packageSource>
    </packageSourceMapping>
    <packageSourceCredentials>
        <private-github>
            <!-- Values come from env vars (local: your PAT with read:packages; CI: github.actor +
                 the built-in GITHUB_TOKEN, wired in .github/workflows/*). Both %VARS% must resolve. -->
            <add key="Username" value="%GITHUB_PACKAGE_USER%" />
            <add key="ClearTextPassword" value="%GITHUB_PACKAGE_TOKEN%" />
        </private-github>
    </packageSourceCredentials>

</configuration>
