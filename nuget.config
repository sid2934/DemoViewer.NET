<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <!--To inherit the global NuGet package sources remove the <clear/> line below -->
        <clear/>
        <add key="nuget" value="https://api.nuget.org/v3/index.json"/>
        <!--
            LOCAL DEVELOPMENT FEED, not part of a clean checkout's requirements.

            Holds locally packed CS2DemoKit builds so engine work in a sibling checkout can be
            consumed here before it is published. The <clear/> above still applies: it drops the
            machine-global sources, and this is added alongside nuget.org rather than replacing it,
            so every third-party package still resolves from nuget.org exactly as before.

            The packages carried here use a prerelease version (0.11.0-aim1) that no published build
            will ever have, so a stale local package cannot silently shadow a real release. Restore
            fails loudly with NU1102 if the directory is missing, which is the intended outcome:
            the pinned prerelease exists nowhere else.
        -->
        <add key="local" value="C:\dev\local-nuget"/>
    </packageSources>
</configuration>
