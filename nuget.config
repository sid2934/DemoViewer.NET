<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <!--To inherit the global NuGet package sources remove the <clear/> line below -->
        <clear />
        <add key="nuget" value="https://api.nuget.org/v3/index.json" />
        <!-- Repo-local feed, now down to a single package: Cs2VideoGenerator.Core, which is not
             published anywhere public. The committed .nupkg is its source of record, so a bare
             clone and a CI runner both build with no credentials. Refresh by copying a newer
             .nupkg here and bumping the version in Directory.Packages.props.

             The CS2OpenDev family used to live here too; it is on nuget.org as of 2026-08 and
             restores like everything else. -->
        <add key="local" value="local-packages" />
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget">
            <package pattern="*" />
        </packageSource>
        <!-- Without this explicit pattern the `*` above routes Cs2VideoGenerator.Core to nuget.org,
             where it does not exist, and a clean restore (fresh runner, no global cache) fails with
             NU1102. Most-specific match wins. Keep in sync with Directory.Packages.props. -->
        <packageSource key="local">
            <package pattern="Cs2VideoGenerator*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
