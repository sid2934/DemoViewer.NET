<Project Sdk="Microsoft.NET.Sdk">

    <!-- Signs and verifies staged extension directories.
         Out of the .slnx on purpose: a small CI/owner utility, not an app component. Links the app's
         own ExtensionSignature.cs and PublisherKeys.cs rather than referencing the app project, so the
         tool and the app run exactly the same digest and verify code without pulling in Avalonia. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>extension-signing</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <AnalysisMode>Minimum</AnalysisMode>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <InvariantGlobalization>true</InvariantGlobalization>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\..\src\App\DemoViewer.NET\Extensions\Loading\ExtensionSignature.cs" Link="Shared\ExtensionSignature.cs"/>
        <Compile Include="..\..\src\App\DemoViewer.NET\Extensions\Loading\PublisherKeys.cs" Link="Shared\PublisherKeys.cs"/>
        <!-- Pure value types the packaging step needs (report, feed-merge, feed-check): no Avalonia, no
             CS2DemoKit, nothing that would turn this into an app reference. -->
        <Compile Include="..\..\src\App\DemoViewer.NET\Extensions\Manifest\SemVersion.cs" Link="Shared\SemVersion.cs"/>
        <Compile Include="..\..\src\App\DemoViewer.NET\Extensions\Manifest\VersionRange.cs" Link="Shared\VersionRange.cs"/>
        <Compile Include="..\..\src\App\DemoViewer.NET\Extensions\Manifest\ExtensionHostInfo.cs" Link="Shared\ExtensionHostInfo.cs"/>
        <Compile Include="..\..\src\App\DemoViewer.NET\Extensions\Manifest\ExtensionManifest.cs" Link="Shared\ExtensionManifest.cs"/>
        <Compile Include="..\..\src\App\DemoViewer.NET\Extensions\Manifest\PackCompatibility.cs" Link="Shared\PackCompatibility.cs"/>
        <Compile Include="..\..\src\App\DemoViewer.NET\Extensions\Manifest\CompatibilityReport.cs" Link="Shared\CompatibilityReport.cs"/>
        <Compile Include="..\..\src\App\DemoViewer.NET\Extensions\Updates\ExtensionFeed.cs" Link="Shared\ExtensionFeed.cs"/>
        <!-- The manifest checks ruleset names with the SDK's rule; the SDK project itself pulls in Avalonia. -->
        <Compile Include="..\..\src\Sdk\DemoViewer.NET.Extensions.Sdk\Rulesets.cs" Link="Shared\Rulesets.cs"/>
        <Using Include="DemoViewer.NET.Extensions.Sdk"/>
    </ItemGroup>

</Project>
