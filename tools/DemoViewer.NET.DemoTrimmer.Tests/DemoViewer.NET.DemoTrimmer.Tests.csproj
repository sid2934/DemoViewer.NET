<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>DemoViewer.NET.DemoTrimmer.Tests</AssemblyName>
        <RootNamespace>DemoViewer.NET.DemoTrimmer.Tests</RootNamespace>
        <!-- CA1707: test method names conventionally use underscores (e.g. Method_Condition_Expected) -->
        <NoWarn>$(NoWarn);CA1707</NoWarn>
        <!-- Heavy demo parse + two EntityTracker replays in one process on a 16 GB machine. -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../DemoViewer.NET.DemoTrimmer/DemoViewer.NET.DemoTrimmer.csproj"/>
        <PackageReference Include="CS2DemoKit.Parser"/>
        <ProjectReference Include="../../src/Testing/DemoViewer.NET.TestSupport/DemoViewer.NET.TestSupport.csproj"/>
    </ItemGroup>

</Project>
