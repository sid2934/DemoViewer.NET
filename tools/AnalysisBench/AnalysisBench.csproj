<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <!-- The parallel digest producer fans out ~dozens of allocating decode workers. Workstation
             GC's stop-the-world Gen0 serializes them (every thread stalls on any thread's collection); Server
             GC's per-core heaps + background collection let them run concurrently. -->
        <ServerGarbageCollection>true</ServerGarbageCollection>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Parser/Cs2DemoKit.Parser/Cs2DemoKit.Parser.csproj"/>
        <ProjectReference Include="../../src/Analysis/Cs2DemoKit.Analysis/Cs2DemoKit.Analysis.csproj"/>
    </ItemGroup>
</Project>
