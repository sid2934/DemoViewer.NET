<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <!-- The parallel digest producer fans out ~dozens of allocating decode workers. Workstation
             GC's stop-the-world Gen0 serializes them (every thread stalls on any thread's collection); Server
             GC's per-core heaps + background collection let them run concurrently. -->
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <!-- Linked SDK/app files doc-comment crefs against siblings this project does not also link
             (IExtensionContributions, IPassContext, ...); CS1574 on those is expected, not a defect. -->
        <NoWarn>$(NoWarn);CS1574</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <!-- Shared by SOURCE rather than duplicated: the bench has to resolve and inflate a bake the
             same way the app does, and a second copy of the probe order is how the two drift apart.
             A ProjectReference would drag Avalonia into a console bench, so it is not an option. -->
        <Compile Include="../../src/App/DemoViewer.NET/Services/CollisionSoup.cs" Link="CollisionSoup.cs"/>
        <Compile Include="../../src/App/DemoViewer.NET/Services/DemoProcessing/ForwardDemoPass.cs" Link="ForwardDemoPass.cs"/>
        <!-- RegisteredCollector.Guard is ICollectorFaultReporter, not ExtensionGuard: ExtensionGuard
             reaches Avalonia.Threading through ExtensionFaults, and a ProjectReference to pull it
             in is not an option (see the comment above). -->
        <Compile Include="../../src/App/DemoViewer.NET/Services/DemoProcessing/Collectors/CollectorSet.cs" Link="Collectors/CollectorSet.cs"/>
        <Compile Include="../../src/App/DemoViewer.NET/Services/DemoProcessing/Collectors/CollectorObserver.cs" Link="Collectors/CollectorObserver.cs"/>
        <Compile Include="../../src/App/DemoViewer.NET/Services/DemoProcessing/Collectors/ICollectorFaultReporter.cs" Link="Collectors/ICollectorFaultReporter.cs"/>
        <Compile Include="../../src/Sdk/DemoViewer.NET.Extensions.Sdk/Collectors.cs" Link="Sdk/Collectors.cs"/>
        <PackageReference Include="CS2DemoKit.Parser"/>
        <PackageReference Include="CS2DemoKit.Analysis"/>
    </ItemGroup>
</Project>
