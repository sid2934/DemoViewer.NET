<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- BenchmarkDotNet refuses to run a non-optimized build; always invoke with -c Release. -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="CS2DemoKit.Parser"/>
        <!-- For the hot-path targets: PawnLookup.ForEachLivePawn + PawnHealthProvider.CaptureAllSlots
             (the per-frame entity-set walk that profiling identified as the dominant cost). -->
        <PackageReference Include="CS2DemoKit.Analysis"/>
    </ItemGroup>

</Project>
