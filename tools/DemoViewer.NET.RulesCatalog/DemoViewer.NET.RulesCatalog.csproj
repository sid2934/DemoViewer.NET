<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <EnableNETAnalyzers>false</EnableNETAnalyzers>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Analysis\Cs2DemoKit.Analysis\Cs2DemoKit.Analysis.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="YamlDotNet"/>
    </ItemGroup>

    <!-- Curated view vocabulary read by CatalogBuilder. Embedded so the drift test (which calls
         CatalogBuilder.Build straight from the RulesCatalog assembly) reads the exact bytes the
         generator did, without a filesystem walk. -->
    <ItemGroup>
        <EmbeddedResource Include="data\views.yaml" LogicalName="DemoViewer.NET.RulesCatalog.data.views.yaml"/>
    </ItemGroup>

</Project>
