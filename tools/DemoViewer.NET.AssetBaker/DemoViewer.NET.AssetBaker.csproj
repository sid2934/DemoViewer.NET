<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The CS2 map-asset BAKER.
      A SEPARATE tool: it owns VRF + ValvePak + Svg.Skia. The app NEVER references this project (no
      ProjectReference). SkiaSharp comes from central package management, so the baker rasterises with
      the same SkiaSharp the app does. Interop is over a FILE boundary (baked PNG + JSON).

      Build/run standalone (NOT part of the main .slnx) via "dotnet run" against this project;
      pass map names as args and an optional diag flag. See Program.cs for the exact CLI.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>

        <!-- Standalone dev tool: relax the repo's warnings-as-errors so VRF-interop nullability etc. don't block. -->
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup>
        <!-- A standalone dev tool needs no git versioning. -->
        <PackageReference Remove="Nerdbank.GitVersioning"/>
        <PackageReference Include="ValveResourceFormat" VersionOverride="19.2.6339"/>
        <PackageReference Include="ValvePak" VersionOverride="4.0.0.142"/>
        <PackageReference Include="SkiaSharp"/>
        <PackageReference Include="SkiaSharp.NativeAssets.macOS"/>
        <!-- Both natives: the icon bake runs on whichever machine has CS2 installed, which in
             practice is a Windows one. No RuntimeIdentifier is set, so the host picks its own. -->
        <PackageReference Include="SkiaSharp.NativeAssets.Win32"/>
        <!-- The icon bake ONLY. CS2 ships its iconography as compiled Panorama SVG, so the baker needs
             an SVG rasteriser; Svg.Skia is the one that rides SkiaSharp 3.x. It is confined to this
             project by the file boundary. -->
        <PackageReference Include="Svg.Skia" VersionOverride="3.0.2"/>
    </ItemGroup>

</Project>
