<Project>
    <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup>
        <!-- Avalonia packages -->
        <!-- Important: keep version in sync! -->
        <PackageVersion Include="Avalonia" Version="11.3.12"/>
        <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="11.3.12"/>
        <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.12"/>
        <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.12"/>
        <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.12"/>
        <PackageVersion Include="Avalonia.Desktop" Version="11.3.12"/>
        <PackageVersion Include="Avalonia.iOS" Version="11.3.12"/>
        <PackageVersion Include="Avalonia.Browser" Version="11.3.12"/>
        <PackageVersion Include="Avalonia.Android" Version="11.3.12"/>
        <!-- AvaloniaEdit — Rulesets v2 authoring Workbench editor (Phase 3). Tracks the Avalonia 11.3.x line. -->
        <PackageVersion Include="Avalonia.AvaloniaEdit" Version="11.3.0"/>
        <!-- Headless UI testing (TUnit + SkiaSharp frame capture). Keep in sync with Avalonia version. -->
        <PackageVersion Include="Avalonia.Headless" Version="11.3.12"/>
        <PackageVersion Include="Avalonia.Skia" Version="11.3.12"/>
        <PackageVersion Include="Msagl" Version="1.2.1"/>
        <PackageVersion Include="YamlDotNet" Version="16.3.0"/>
        <!--
            The demo parser and analysis engine, from nuget.org. These were in-repo projects until
            2026-08-17; they now live at github.com/CS2OpenDev/CS2DemoKit and this app is one
            consumer among others.

            Versioned in lockstep and exact-pinned to each other inside the packages, so bump all
            three together in one commit. CS2DemoKit.Analysis is the top of that graph and pulls
            the other two transitively; the explicit references below are for the projects that
            use the parser without the engine.
        -->
        <PackageVersion Include="CS2DemoKit.Parser" Version="0.9.1"/>
        <PackageVersion Include="CS2DemoKit.Analysis" Version="0.9.1"/>
        <PackageVersion Include="CS2DemoKit.Analysis.Rules" Version="0.9.1"/>
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0"/>
        <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15"/>
        <!-- 3.29.5+ required by Cs2VideoGenerator.Core, and comfortably above the >= 3.27.0 floor
             CS2OpenDev.Protos states as policy. Grpc.Tools is gone: the parser no longer runs
             protoc — the Valve message types arrive prebuilt in CS2OpenDev.Protos below. -->
        <PackageVersion Include="Google.Protobuf" Version="3.29.5"/>
        <!-- CSVG live-CS2 integration (docs/csvg-integration/), from
             github.com/CS2OpenDev/CS2VideoGenerator.

             0.9.0 is the newest published version, NOT a downgrade from the 1.x line that predates
             the public release: that line was private, and the public one restarted below 1.0.0 to
             leave room for fixes before 1.0.0. A 1.x is therefore older than what is here — treat
             any such "upgrade" as a regression. -->
        <PackageVersion Include="Cs2VideoGenerator.Core" Version="0.9.0"/>
        <PackageVersion Include="Snappier" Version="1.3.1"/>
        <!-- Fuzzy matcher for the command palette (F8.1). Pure-managed; WASM-safe. -->
        <PackageVersion Include="FuzzySharp" Version="2.0.2"/>
        <!-- Versioning -->
        <PackageVersion Include="Nerdbank.GitVersioning" Version="3.7.115"/>
        <!-- Install / auto-update packaging (docs/distribution/build-and-packaging-plan.md §5).
             Keep in sync with the vpk CLI pin in .config/dotnet-tools.json. -->
        <PackageVersion Include="Velopack" Version="1.2.0"/>
        <!-- Test -->
        <PackageVersion Include="TUnit" Version="0.25.21"/>
        <!-- Micro-benchmark harness (tools/EntityMicroBench) -->
        <PackageVersion Include="BenchmarkDotNet" Version="0.14.0"/>
        <!--
            The CS2OpenDev family — community-maintained CS2 schema, protobuf and game-event
            definitions (github.com/CS2OpenDev). On nuget.org since 2026-08 under a renumbered
            public line, which replaced the withdrawn 5.x GitHub Packages line; they restore like
            any other dependency now, with no feed mapping and no credentials.

            These versions must match what the CS2DemoKit packages above depend on. Only
            CS2OpenDev.Sdk is referenced directly here (the App reads SchemaNames.* constants); the
            rest arrive transitively through the parser and are pinned so a mismatched pair cannot
            resolve silently.
        -->
        <PackageVersion Include="CS2OpenDev.Sdk" Version="0.9.0"/>
        <PackageVersion Include="CS2OpenDev.Sdk.GameEvents" Version="0.9.0"/>
        <PackageVersion Include="CS2OpenDev.Sdk.Entities.Abstractions" Version="1.0.3"/>
        <PackageVersion Include="CS2OpenDev.Sdk.Entities" Version="1.1.3"/>
        <PackageVersion Include="CS2OpenDev.Protos" Version="0.9.0"/>
        <!-- ^ 5.0.1 is the family renumber riding the Sdk 5.0 TypeMapper repair; protos/ is
             byte-identical to 4.1.1 (empty tag diff, audited 2026-08-13). -->

        <!-- Configuration + Options + DI (App settings foundation, P1.1). DI is consumed in a later
             chunk (App bootstrap); the refs live here so SettingsService can use Configuration/Options
             now. Microsoft.Extensions.Hosting is intentionally NOT added. Pinned to the net10.0 line. -->
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0"/>
        <!-- Logging (unified diagnostics pillar). Abstractions carries ILogger + [LoggerMessage]
             source generator and is WASM-safe (no providers); the App references the full Logging
             package for LoggerFactory + a custom in-memory ILoggerProvider (also WASM-safe — Blazor
             WASM uses it). OTLP/file exporters are NOT added here; they belong at the Desktop
             boundary. Pinned to the net10.0 line. -->
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0"/>
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.0"/>
    </ItemGroup>
</Project>
