<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DemoViewer.NET.Views.ReplayMiniMapControl"
             MinHeight="160">

  <Border Background="#06060F"
          BorderBrush="#10102A"
          BorderThickness="1">
    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="6">
      <TextBlock Text="MINI-MAP"
                 FontFamily="Consolas,Menlo,monospace"
                 FontSize="10"
                 FontWeight="SemiBold"
                 Foreground="#1E1E38"
                 HorizontalAlignment="Center"/>
      <TextBlock Text="Player positions — coming soon"
                 FontFamily="Consolas,Menlo,monospace"
                 FontSize="11"
                 Foreground="#1A1A32"
                 HorizontalAlignment="Center"/>
    </StackPanel>
  </Border>

</UserControl>
