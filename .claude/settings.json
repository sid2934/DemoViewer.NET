{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "deny": [
      "Bash(git worktree remove --force:*)",
      "Bash(rm -rf demos:*)",
      "Bash(rm -rf ./demos:*)",
      "Bash(rm -r demos:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/guard_demos.py",
            "timeout": 10,
            "statusMessage": "checking for demo-corpus deletion"
          }
        ]
      }
    ]
  }
}